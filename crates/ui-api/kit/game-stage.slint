import { Tokens } from "../tokens.slint";
import { Look } from "look.slint";

// A game on the whole screen, as its launch and its closing show it: its art dimmed behind its
// cover, its title, a line under it, what the screen adds (`@children`), and a turning ring.
// While `on`, the art settles from a slight zoom, the cover springs in and the ring turns.
export component GameStage inherits Rectangle {
    in property <bool> on: true;
    // The game's background, behind everything, dimmed; its cover when it has none.
    in property <image> background-image;
    in property <image> cover-image;
    in property <string> title;
    // The title's accessible label, for the screen's tests: empty for none.
    in property <string> title-label;
    in property <string> line;
    // The line's accessible label: empty for none.
    in property <string> line-label;
    background: Tokens.color-shade;

    Image {
        source: root.background-image.width > 0 ? root.background-image : root.cover-image;
        width: root.width;
        height: root.height;
        image-fit: cover;
        opacity: 0.45;
        transform-scale: root.on ? 1.0 : 1.08;
        animate transform-scale { duration: root.on ? Look.timed(6s) : 0ms; easing: ease-out-quint; }
    }
    Rectangle {
        background: @radial-gradient(circle, Tokens.color-shade.with-alpha(0.2) 0%, Tokens.color-shade.with-alpha(0.851) 75%);
    }
    VerticalLayout {
        alignment: center;
        spacing: 0;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 220 * Look.px;
                height: 220 * Look.px;
                border-radius: 28 * Look.px;
                clip: true;
                background: Tokens.color-surface;
                transform-scale: root.on ? 1.0 : 0.86;
                animate transform-scale { duration: Look.timed(600ms); easing: ease-out-back; }
                drop-shadow-blur: 40 * Look.px;
                drop-shadow-color: Tokens.color-shade.with-alpha(0.6);
                Image { source: root.cover-image; width: parent.width; height: parent.height; image-fit: cover; }
            }
        }
        Rectangle { height: 34 * Look.px; }
        Text {
            text: root.title;
            font-size: 44 * Look.px;
            font-weight: 600;
            color: Tokens.color-text;
            horizontal-alignment: center;
            accessible-role: text;
            accessible-label: root.title-label;
            accessible-value: self.text;
        }
        if root.line != "" : Rectangle { height: 10 * Look.px; }
        if root.line != "" : Text {
            text: root.line;
            font-size: 20 * Look.px;
            color: Tokens.color-text-muted;
            horizontal-alignment: center;
            accessible-role: text;
            accessible-label: root.line-label;
            accessible-value: self.text;
        }
        @children
        Rectangle { height: 36 * Look.px; }
        HorizontalLayout {
            alignment: center;
            Path {
                width: 44 * Look.px;
                height: 44 * Look.px;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: Tokens.color-text;
                stroke-width: 2.5 * Look.px;
                commands: "M 12 3 A 9 9 0 1 1 3 12";
                transform-rotation: root.on ? Look.clock * 400deg : 0deg;
            }
        }
        Rectangle { height: 40 * Look.px; }
    }
}
