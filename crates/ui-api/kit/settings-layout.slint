import { Vm } from "../types.slint";
import { Sys } from "system-panel.slint";

// Where the rows of each of Settings' tabs are. A row that isn't always there (Start at login,
// Screen, a VPN, the System rows) moves the rows after it, so each tab counts its rows here, with
// the same conditions as the rows in settings-sections.slint. `Prefs.rows` reads the counts, to
// know where the keys stop. A row's number is a row's place in its tab; -1 is a row that doesn't
// show.

// LAUNCHER: the first five rows are fixed. The screen moves down when "Start at login" shows.
// "Top bar" is the last row.
export global LauncherRows {
    out property <int> screen: Vm.can-start-at-login ? 6 : 5;
    out property <int> top-bar: root.screen + (Vm.monitors.length > 1 ? 1 : 0);
    out property <int> count: root.top-bar + 1;
}

// DOWNLOADS: the VPN switch, then the VPNs (or the row that says there is none), "Add a VPN"
// where the system can, then sharing.
export global DownloadsRows {
    out property <int> vpns: Vm.vpn.problem != "" ? 0 : Math.max(1, Vm.vpn.vpns.length);
    out property <bool> import: Vm.vpn.problem == "" && Vm.vpn.can-import;
    out property <int> import-row: 1 + root.vpns;
    out property <int> share-row: root.import-row + (root.import ? 1 : 0);
    out property <int> count: root.share-row + 1;
}

// SYSTEM: Internet, Sound and Bluetooth, then the Marah OS update and the install, when they show.
export global SystemRows {
    out property <int> os: Vm.system.os-update != "" ? 3 : -1;
    out property <int> install: Vm.system.stick ? 3 + (root.os >= 0 ? 1 : 0) : -1;
    out property <int> count: 3 + (root.os >= 0 ? 1 : 0) + (root.install >= 0 ? 1 : 0);
}

// BACKUP: "Back up now", the switch for large items (when a plugin has some), the backup
// folder, "Restore from another folder", "Restart Marah Launcher" after a restore, then one row per
// backup.
export global BackupRows {
    out property <int> large: Vm.backup.large != "" ? 1 : -1;
    out property <int> folder: root.large >= 0 ? 2 : 1;
    out property <int> other: root.folder + 1;
    out property <int> restart: Vm.backup.restart ? root.other + 1 : -1;
    out property <int> first-backup: root.other + 1 + (root.restart >= 0 ? 1 : 0);
    out property <int> count: root.first-backup + Vm.backup.backups.length;
}

// POWER: "Quit Marah Launcher" ("Restart Marah Launcher" when Marah Launcher is the whole screen: the session starts it
// again), then Log out only in the Marah Launcher session on a desktop (on Marah OS the session
// would just start again), then Restart and Shut down wherever the power area allows them.
export global PowerRows {
    out property <int> logout: Vm.system.whole-screen && !Vm.system.own-os ? 1 : -1;
    out property <int> restart: 1 + (root.logout >= 0 ? 1 : 0);
    out property <int> count: Sys.power-on ? root.restart + 2 : root.restart;
}
