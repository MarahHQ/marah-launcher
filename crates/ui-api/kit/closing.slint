import { Vm } from "../types.slint";
import { Tokens } from "../tokens.slint";
import { Look } from "look.slint";
import { Reveal } from "reveal.slint";
import { GameStage } from "game-stage.slint";
import { CoverWall } from "cover-wall.slint";
import { Brand } from "../brand.slint";

// Log out, Restart or Shut down closes what runs first: the running games, then what their
// launches left running (Steam's client). The screen is covered with the step it is at
// (`Vm.closing`), so the player sees why it waits. While the step closes a game
// (`Vm.closing-game`), it shows that game as its launch did: its art and cover, its title and
// "Closing…". For another step ("Closing Steam", "Logging out"), it shows Marah Launcher as the boot
// screen does: a slowly drifting wall of the library's covers, soft moving light, the emblem
// (`logo`, the theme's), and the step. A turning ring under both. It fades in.
export global Closing {
    // The closing screen shows. It takes every key: a shell hides its key hints meanwhile.
    out property <bool> shows: Vm.closing != "";
}

// Marah Launcher on the whole screen, with `step` under its emblem.
component MarahStage inherits Rectangle {
    in property <image> logo;
    in property <string> step;
    property <float> t: Look.clock;
    background: Tokens.color-bg;
    clip: true;

    // A slowly drifting wall of the library's covers.
    CoverWall { }
    // A vignette and drifting light keep the middle calm and readable.
    Rectangle {
        background: @radial-gradient(circle, Tokens.color-bg.with-alpha(0.85) 0%, Tokens.color-bg.with-alpha(0.65) 45%, Tokens.color-bg.with-alpha(0.25) 100%);
    }
    Rectangle {
        x: root.width * (0.30 + 0.06 * Math.sin(root.t * 9deg)) - self.width / 2;
        y: root.height * (0.35 + 0.05 * Math.cos(root.t * 7deg)) - self.height / 2;
        width: 1100 * Look.px;
        height: self.width;
        background: @radial-gradient(circle, Tokens.color-accent.with-alpha(0.24) 0%, Tokens.color-accent.with-alpha(0) 65%);
    }
    Rectangle {
        x: root.width * (0.70 + 0.05 * Math.cos(root.t * 8deg)) - self.width / 2;
        y: root.height * (0.62 + 0.06 * Math.sin(root.t * 6deg)) - self.height / 2;
        width: 1000 * Look.px;
        height: self.width;
        background: @radial-gradient(circle, Tokens.color-info.with-alpha(0.18) 0%, Tokens.color-info.with-alpha(0) 65%);
    }

    VerticalLayout {
        alignment: center;
        spacing: 0;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 132 * Look.px;
                height: self.width;
                Rectangle {
                    x: -40 * Look.px;
                    y: -40 * Look.px;
                    width: parent.width + 80 * Look.px;
                    height: self.width;
                    background: @radial-gradient(circle, Tokens.color-accent-soft.with-alpha(0.4) 0%, Tokens.color-accent-soft.with-alpha(0) 68%);
                    opacity: 0.28;
                }
                Image { source: root.logo; width: parent.width; height: parent.height; image-fit: contain; }
            }
        }
        Rectangle { height: 24 * Look.px; }
        Text {
            text: Brand.name-caps;
            font-size: 19 * Look.px;
            font-weight: 600;
            letter-spacing: 3 * Look.px;
            color: Tokens.color-text-muted;
            horizontal-alignment: center;
        }
        Rectangle { height: 30 * Look.px; }
        Text {
            text: root.step;
            font-size: 32 * Look.px;
            font-weight: 600;
            color: Tokens.color-text;
            horizontal-alignment: center;
            accessible-role: text;
            accessible-label: "closing-title";
            accessible-value: self.text;
        }
        Rectangle { height: 30 * Look.px; }
        HorizontalLayout {
            alignment: center;
            Path {
                width: 40 * Look.px;
                height: 40 * Look.px;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: Tokens.color-accent-soft;
                stroke-width: 2.5 * Look.px;
                commands: "M 12 3 A 9 9 0 1 1 3 12";
                transform-rotation: Look.clock * 400deg;
            }
        }
    }
}

export component ClosingScreen inherits Rectangle {
    // The theme's Marah Launcher emblem, for the steps about no game.
    in property <image> logo;
    // It fades in after its first frame.
    fade-in := Reveal { }
    opacity: fade-in.fade;
    TouchArea { }
    if Vm.has-closing-game : GameStage {
        background-image: Vm.closing-game.background;
        cover-image: Vm.closing-game.cover;
        title: Vm.closing-game.title;
        title-label: "closing-title";
        line: "Closing…";
        line-label: "closing-step";
    }
    if !Vm.has-closing-game : MarahStage {
        logo: root.logo;
        step: Vm.closing + "…";
    }
    // The step as it is, for the shell's tests and screen readers.
    Rectangle {
        accessible-role: text;
        accessible-label: "closing";
        accessible-value: Vm.closing;
    }
}
