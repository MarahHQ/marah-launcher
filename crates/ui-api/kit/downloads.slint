import { Vm, Host, Torrent, TorrentPick } from "../types.slint";
import { Commands } from "commands.slint";
import { Tokens } from "../tokens.slint";
import { Look } from "look.slint";
import { Reveal } from "reveal.slint";
import { Button } from "button.slint";
import { ProgressBar } from "progress-bar.slint";
import { Pill } from "widgets.slint";
import { Icon } from "icon.slint";
import { Editor, Prefs, Row, Value } from "settings-rows.slint";
import { Brand } from "../brand.slint";

// The keys on Downloads. The rows are each torrent, then each emulator download; `button` is
// the button in the row's card. "Keep sharing finished downloads" is in Settings.
export global Dl {
    in-out property <int> row;
    in-out property <int> button;
    out property <int> rows: Vm.torrents.length + Vm.downloads.length;

    // The torrent at `row`, or -1.
    public pure function torrent(row: int) -> int {
        return row >= 0 && row < Vm.torrents.length ? row : -1;
    }
    // The emulator download at `row`, or -1.
    public pure function job(row: int) -> int {
        let i = row - Vm.torrents.length;
        return i >= 0 && i < Vm.downloads.length ? i : -1;
    }
    // An emulator download's buttons, in order: resume, pause, cancel.
    public pure function job-actions(i: int) -> int {
        return (Vm.downloads[i].can-resume ? 1 : 0) + (Vm.downloads[i].can-pause ? 1 : 0) + (Vm.downloads[i].can-cancel ? 1 : 0);
    }
    public pure function job-action(i: int, n: int) -> string {
        let resume = Vm.downloads[i].can-resume ? 1 : 0;
        let pause = Vm.downloads[i].can-pause ? 1 : 0;
        return n < resume ? "resume" : n < resume + pause ? "pause" : "cancel";
    }
    // A torrent's folder is on disk from its start: Open folder comes after its actions.
    public pure function has-folder(i: int) -> bool {
        // A store's install is in the store's own folders.
        return Vm.torrents[i].store == "" && Vm.torrents[i].state != "resolving" && Vm.torrents[i].state != "ready";
    }
    public pure function buttons(row: int) -> int {
        return root.torrent(row) >= 0 ? Vm.torrents[root.torrent(row)].actions.length + (root.has-folder(root.torrent(row)) ? 1 : 0)
            : root.job(row) >= 0 ? root.job-actions(root.job(row))
            : 0;
    }
    // The focused button: kept on the card's last one when its buttons get fewer.
    out property <int> at: Math.max(0, Math.min(root.button, root.buttons(root.row) - 1));

    // The install sheet is open, asking the player first: the torrent's index and id, or -1.
    // The keys are on Install (0), Not now (1) or the folder row above them (2).
    in-out property <int> install: -1;
    in-out property <string> install-id;
    in-out property <int> install-focus;
    // The folder the player typed in the sheet; "" for the one the download offers.
    in-out property <string> install-folder;
    out property <bool> installing: root.install >= 0 && root.install < Vm.torrents.length
        && Vm.torrents[root.install].id == root.install-id;
    out property <string> shown-install-folder: root.install-folder != "" ? root.install-folder
        : root.installing ? Vm.torrents[root.install].install-folder : "";

    // The download sheet of a Ready download is open: the torrent's index and id, or -1. The
    // keys are on Select all (-2), Select none (-1), a file (0 to its files' count - 1), then the
    // game folder row (`files`), Download and install (`files` + 1), Download (`files` + 2) and
    // Not now (`files` + 3). It closes once the download starts.
    in-out property <int> start: -1;
    in-out property <string> start-id;
    in-out property <int> start-focus;
    // The game folder the player typed in the sheet; "" for the one the download offers.
    in-out property <string> start-folder;
    out property <bool> starting: root.start >= 0 && root.start < Vm.torrents.length
        && Vm.torrents[root.start].id == root.start-id && Vm.torrents[root.start].state == "ready";
    out property <int> files: root.starting ? Vm.torrents[root.start].picks.length : 0;
    out property <string> shown-start-folder: root.start-folder != "" ? root.start-folder
        : root.starting ? Vm.torrents[root.start].install-folder : "";
    // Download and install: a game folder, and room on both drives. The room is known for the
    // game folder the sheet offers; the core checks a typed one, and the sheet says why.
    out property <bool> can-install: root.starting && root.shown-start-folder != ""
        && Vm.torrents[root.start].download-room == ""
        && (root.start-folder != "" || Vm.torrents[root.start].install-room == "");
    out property <bool> can-download: root.starting && Vm.torrents[root.start].download-room == "";

    // The remove sheet is open, asking whether the files go too: the torrent's index and id, or
    // -1. The keys are on Remove from Downloads (0), Remove and delete files (1) or Not now (2).
    in-out property <int> remove: -1;
    in-out property <string> remove-id;
    in-out property <int> remove-focus;
    out property <bool> removing: root.remove >= 0 && root.remove < Vm.torrents.length
        && Vm.torrents[root.remove].id == root.remove-id;

    public function reset() {
        root.row = 0;
        root.button = 0;
        root.install = -1;
        root.remove = -1;
        root.start = -1;
        Prefs.editing = false;
    }

    // The download sheet: the keys start on Download and install, or on Download when the game
    // can't install there.
    public function open-start(t: int) {
        root.start = t;
        root.start-id = Vm.torrents[t].id;
        root.start-folder = "";
        let installs = Vm.torrents[t].install-folder != "" && Vm.torrents[t].install-room == "" && Vm.torrents[t].download-room == "";
        root.start-focus = Vm.torrents[t].picks.length + (installs ? 1 : 2);
        Host.play-sound("select");
    }
    public function close-start() {
        root.start = -1;
        Prefs.editing = false;
    }
    // Checks or unchecks file `i`; the game itself stays on.
    public function toggle-file(i: int) {
        if (!Vm.torrents[root.start].picks[i].locked) {
            Commands.pick-file(root.start-id, i, !Vm.torrents[root.start].picks[i].on);
            Host.play-sound("move");
        }
    }
    public function pick-all(on: bool) {
        Commands.pick-file(root.start-id, -1, on);
        Host.play-sound("move");
    }
    // Opens the sheet's game folder row for typing.
    public function edit-start-folder() {
        root.start-focus = root.files;
        Prefs.edit-text = root.shown-start-folder;
        Prefs.editing = true;
    }
    // Download (`install` false), or Download and install. The sheet closes once it starts,
    // and stays open with the core's reason when it doesn't.
    public function begin(install: bool) {
        if (install ? root.can-install : root.can-download) {
            Commands.begin-download(root.start-id, install, install ? root.start-folder : "");
        }
    }
    // The download sheet's keys.
    function start-key(text: string) -> bool {
        // The folder is open for typing: the text box has the keys; Escape closes it.
        if (Prefs.editing) {
            if (text == Key.Escape) { Prefs.editing = false; }
            return true;
        }
        let f = root.files;
        let at = root.start-focus;
        let folder = Vm.torrents[root.start].install-folder != "";
        if (text == Key.DownArrow) {
            let next = at < 0 ? (f > 0 ? 0 : (folder ? f : f + 1))
                : at < f - 1 ? at + 1
                : at == f - 1 ? (folder ? f : f + 1)
                : at == f ? f + 1
                : at;
            if (next != at) { root.start-focus = next; Host.play-sound("move"); }
            return true;
        }
        if (text == Key.UpArrow) {
            let next = at > f ? (folder ? f : Math.max(f - 1, -2))
                : at > 0 ? at - 1
                : at == 0 ? -2
                : at;
            if (next != at) { root.start-focus = Math.max(next, -2); Host.play-sound("move"); }
            return true;
        }
        if (text == Key.LeftArrow || text == Key.RightArrow) {
            let forward = (text == Key.RightArrow) != Look.rtl;
            if (at < 0) { root.start-focus = forward ? -1 : -2; }
            else if (at > f) { root.start-focus = Math.clamp(at + (forward ? 1 : -1), f + 1, f + 3); }
            if (root.start-focus != at) { Host.play-sound("move"); }
            return true;
        }
        if (text == Key.Return) {
            if (at == -2) { root.pick-all(true); }
            else if (at == -1) { root.pick-all(false); }
            else if (at < f) { root.toggle-file(at); }
            else if (at == f) { root.edit-start-folder(); }
            else if (at == f + 1) { root.begin(true); }
            else if (at == f + 2) { root.begin(false); }
            else { root.close-start(); Host.play-sound("back"); }
            return true;
        }
        if (text == Key.Escape || text == Key.Backspace) { root.close-start(); Host.play-sound("back"); }
        return true;
    }

    // The player's answer on the remove sheet: 0 keeps the files, 1 deletes them, 2 is Not now.
    public function answer-remove(choice: int) {
        if (choice < 2) { Commands.torrent-action(root.remove-id, choice == 0 ? "remove" : "delete-files"); }
        root.remove = -1;
        Host.play-sound(choice < 2 ? "select" : "back");
    }

    // The torrent's action, as its button runs it: Install and Remove ask first.
    public function run(t: int, action: string) {
        if (action == "remove") {
            root.remove = t;
            root.remove-id = Vm.torrents[t].id;
            root.remove-focus = 0;
            Host.play-sound("select");
        } else if (action == "start" && Vm.torrents[t].state == "ready") {
            root.open-start(t);
        } else if (action == "play") {
            Commands.launch(Vm.torrents[t].game);
        } else if (action == "install") {
            root.install = t;
            root.install-id = Vm.torrents[t].id;
            root.install-focus = 0;
            root.install-folder = "";
            Host.play-sound("select");
        } else {
            Commands.torrent-action(Vm.torrents[t].id, action);
        }
    }
    // Opens the sheet's folder row for typing.
    public function edit-install-folder() {
        root.install-focus = 2;
        Prefs.edit-text = root.shown-install-folder;
        Prefs.editing = true;
    }
    // The player agreed: the install starts. The sheet closes once it runs, and stays open
    // with the core's reason when it doesn't.
    public function agree-install() {
        Commands.install-download(root.install-id, root.install-folder);
    }
    public function close-install() {
        root.install = -1;
        Prefs.editing = false;
    }

    public function key(text: string) -> bool {
        if (root.starting) {
            return root.start-key(text);
        }
        if (root.removing) {
            // The answers are a list: Down moves on, as Right does (Left from right to left).
            if (text == Key.UpArrow || text == Key.DownArrow || text == Key.LeftArrow || text == Key.RightArrow) {
                let forward = text == Key.DownArrow || (text != Key.UpArrow && (text == Key.RightArrow) != Look.rtl);
                let next = Math.clamp(root.remove-focus + (forward ? 1 : -1), 0, 2);
                if (next != root.remove-focus) { root.remove-focus = next; Host.play-sound("move"); }
                return true;
            }
            if (text == Key.Return) { root.answer-remove(root.remove-focus); return true; }
            if (text == Key.Escape || text == Key.Backspace) { root.answer-remove(2); }
            return true;
        }
        if (root.install >= 0) {
            // The folder is open for typing: the text box has the keys; Escape closes it.
            if (Prefs.editing) {
                if (text == Key.Escape) { Prefs.editing = false; }
                return true;
            }
            if (text == Key.UpArrow && root.shown-install-folder != "") { root.install-focus = 2; return true; }
            if (text == Key.DownArrow) { root.install-focus = 0; return true; }
            // Install is on the start side: Left, or Right from right to left, goes to it.
            if (text == Key.LeftArrow || text == Key.RightArrow) {
                if (root.install-focus < 2) { root.install-focus = (text == Key.RightArrow) == Look.rtl ? 0 : 1; }
                return true;
            }
            if (text == Key.Return) {
                if (root.install-focus == 2) { root.edit-install-folder(); }
                else if (root.install-focus == 0) { if (root.shown-install-folder != "") { root.agree-install(); } }
                else { root.close-install(); }
                return true;
            }
            if (text == Key.Escape || text == Key.Backspace) { root.close-install(); }
            return true;
        }
        if (text == Key.UpArrow || text == Key.DownArrow) {
            let next = Math.clamp(root.row + (text == Key.DownArrow ? 1 : -1), 0, Math.max(0, root.rows - 1));
            if (next != root.row) {
                root.row = next;
                root.button = 0;
                Host.play-sound("move");
            }
            return true;
        }
        if (text == Key.LeftArrow || text == Key.RightArrow) {
            let forward = (text == Key.RightArrow) == !Look.rtl;
            let next = Math.clamp(root.at + (forward ? 1 : -1), 0, Math.max(0, root.buttons(root.row) - 1));
            if (next != root.at) { Host.play-sound("move"); }
            root.button = next;
            return true;
        }
        if (text == Key.Return) {
            let t = root.torrent(root.row);
            let j = root.job(root.row);
            if (t >= 0 && root.at < Vm.torrents[t].actions.length) {
                root.run(t, Vm.torrents[t].actions[root.at]);
            } else if (t >= 0 && root.has-folder(t)) {
                Host.open-download-folder(Vm.torrents[t].id);
            } else if (j >= 0 && root.job-actions(j) > 0) {
                let action = root.job-action(j, root.at);
                if (action == "resume") { Commands.resume-download(Vm.downloads[j].id); }
                else if (action == "pause") { Commands.pause-download(Vm.downloads[j].id); }
                else { Commands.cancel-download(Vm.downloads[j].id); }
            }
            return true;
        }
        return false;
    }
}

// Asks before a finished download installs: the game, the game folder it goes to, and what
// its emulator installs from. It rises in over a dark wash, as the download sheet. It closes
// once the install (or the unpacking before it) runs; when the core refuses, it stays open and
// says why.
component InstallSheet inherits Rectangle {
    in property <Torrent> torrent;
    // It rises in after its first frame.
    reveal := Reveal { }
    property <bool> started: root.torrent.install == "installing" || root.torrent.install == "done" || root.torrent.unpack == "unpacking";
    changed started => { if (root.started) { Dl.close-install(); } }
    property <TextHorizontalAlignment> align: Look.rtl ? right : left;
    background: reveal.in-view ? Tokens.color-shade.with-alpha(0.69) : transparent;
    animate background { duration: Tokens.motion-normal; }
    TouchArea { }
    Rectangle {
        width: Math.min(820 * Look.px, root.width - 120 * Look.px);
        height: col.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + (1 - reveal.move) * 30 * Look.px;
        opacity: reveal.fade;
        border-radius: 28 * Look.px;
        background: Tokens.color-surface;
        border-width: 1px;
        border-color: Look.line;
        drop-shadow-blur: 60 * Look.px;
        drop-shadow-color: Tokens.color-shade.with-alpha(0.8);
        col := VerticalLayout {
            padding: 44 * Look.px;
            spacing: 16 * Look.px;
            Text {
                text: "Install game";
                font-size: 34 * Look.px;
                font-weight: 700;
                color: Tokens.color-text;
                horizontal-alignment: root.align;
                accessible-role: text;
                accessible-label: "install-title";
                accessible-value: self.text;
            }
            Text {
                text: root.torrent.title + (root.torrent.version != "" ? " · " + root.torrent.version : "") + (root.torrent.region != "" ? " · " + root.torrent.region : "");
                font-size: 22 * Look.px;
                color: Tokens.color-text-muted;
                wrap: word-wrap;
                horizontal-alignment: root.align;
            }
            Text {
                text: Brand.name + " copies or unpacks this finished download into your game folder. The install runs in the background and checks the free space first. It never writes over a game that is there, and the downloaded files stay.";
                font-size: 18 * Look.px;
                color: Tokens.color-text-muted;
                wrap: word-wrap;
                horizontal-alignment: root.align;
            }
            if root.torrent.install-folder == "" : Text {
                text: "This emulator has no game folder: add one in Settings.";
                font-size: 18 * Look.px;
                color: Look.text3;
                wrap: word-wrap;
                horizontal-alignment: root.align;
            }
            // Where it goes: Enter opens it for typing, a folder inside a game folder.
            if root.torrent.install-folder != "" : folder-row := Row {
                property <bool> typing: Prefs.editing && self.focused;
                label: "Game folder";
                hint: "Inside a game folder (Settings) · the next install for this console goes here too";
                first: true;
                last: true;
                focused: Dl.install-focus == 2;
                accessible-role: button;
                accessible-label: "install-folder";
                accessible-value: Dl.shown-install-folder;
                accessible-action-default => { Dl.edit-install-folder(); }
                clicked => { Dl.edit-install-folder(); }
                if !folder-row.typing : Value { text: Dl.shown-install-folder; }
                if folder-row.typing : Editor { horizontal-stretch: 2; done(text) => { Dl.install-folder = text; Dl.install-focus = 0; } }
            }
            Text {
                text: root.torrent.install-note;
                font-size: 18 * Look.px;
                color: Tokens.color-accent-soft;
                wrap: word-wrap;
                horizontal-alignment: root.align;
                accessible-role: text;
                accessible-label: "install-note";
                accessible-value: self.text;
            }
            if root.torrent.install-error != "" : Text {
                text: root.torrent.install-error;
                font-size: 18 * Look.px;
                color: Tokens.color-danger;
                wrap: word-wrap;
                horizontal-alignment: root.align;
                accessible-role: text;
                accessible-label: "install-error";
                accessible-value: self.text;
            }
            // Install first: on the left, or on the right from right to left.
            HorizontalLayout {
                spacing: 16 * Look.px;
                alignment: Look.rtl ? end : start;
                padding-top: 12 * Look.px;
                if Look.rtl : Pill {
                    text: "Not now";
                    focused: Dl.install-focus == 1;
                    accessible-role: button;
                    accessible-label: "install-not-now";
                    accessible-action-default => { Dl.close-install(); }
                    clicked => { Dl.close-install(); }
                }
                Pill {
                    text: "Install";
                    primary: true;
                    enabled: root.torrent.install-folder != "";
                    focused: Dl.install-focus == 0;
                    dim: Dl.install-focus != 0;
                    accessible-role: button;
                    accessible-label: "install-agree";
                    accessible-action-default => { if (self.enabled) { Dl.agree-install(); } }
                    clicked => { if (self.enabled) { Dl.agree-install(); } }
                }
                if !Look.rtl : Pill {
                    text: "Not now";
                    focused: Dl.install-focus == 1;
                    accessible-role: button;
                    accessible-label: "install-not-now";
                    accessible-action-default => { Dl.close-install(); }
                    clicked => { Dl.close-install(); }
                }
            }
        }
    }
}

// A file's checkbox on the download sheet: dimmer when locked.
component FileBox inherits Rectangle {
    in property <bool> on;
    in property <bool> locked;
    width: 26 * Look.px;
    height: 26 * Look.px;
    border-radius: 7 * Look.px;
    border-width: 2 * Look.px;
    border-color: root.on ? Tokens.color-accent : Look.line;
    background: root.on ? (root.locked ? Tokens.color-accent.with-alpha(0.5) : Tokens.color-accent) : transparent;
    if root.on : Icon { name: "check"; width: 20 * Look.px; height: 20 * Look.px; x: 3 * Look.px; y: 3 * Look.px; color: Look.ink; }
}

// What a file is, and its size, on the download sheet.
component FileFacts inherits HorizontalLayout {
    in property <TorrentPick> pick;
    spacing: 14 * Look.px;
    Text {
        text: root.pick.kind == "game" ? (root.pick.locked ? "Game · always" : "Game")
            : root.pick.kind == "update" ? "Update"
            : root.pick.kind == "dlc" ? "DLC"
            : "Extra";
        font-size: 15 * Look.px;
        color: root.pick.kind == "game" ? Tokens.color-accent-soft : Tokens.color-text-muted;
        vertical-alignment: center;
    }
    Text {
        text: root.pick.size;
        font-size: 15 * Look.px;
        color: Tokens.color-text-muted;
        vertical-alignment: center;
        min-width: 80 * Look.px;
        horizontal-alignment: Look.rtl ? left : right;
    }
}

// One file on the download sheet: a checkbox, its path, what it is and its size, mirrored
// from right to left. The game itself has a locked box: it always downloads.
component FileRow inherits Rectangle {
    in property <TorrentPick> pick;
    in property <bool> focused;
    callback toggled();
    height: 44 * Look.px;
    border-radius: 12 * Look.px;
    background: root.focused ? Tokens.color-tint.with-alpha(0.122) : ta.has-hover ? Tokens.color-tint.with-alpha(0.06) : transparent;
    border-width: root.focused ? 2 * Look.px : 0;
    border-color: Look.ring;
    accessible-role: checkbox;
    accessible-label: "download-file";
    accessible-value: root.pick.path;
    accessible-checked: root.pick.on;
    accessible-item-selected: root.focused;
    accessible-enabled: !root.pick.locked;
    accessible-action-default => { root.toggled(); }
    HorizontalLayout {
        padding-left: 12 * Look.px;
        padding-right: 12 * Look.px;
        spacing: 14 * Look.px;
        alignment: stretch;
        if !Look.rtl : VerticalLayout { alignment: center; FileBox { on: root.pick.on; locked: root.pick.locked; } }
        if Look.rtl : FileFacts { pick: root.pick; }
        Text {
            text: root.pick.path;
            font-size: 17 * Look.px;
            color: root.pick.on ? Tokens.color-text : Look.text3;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            horizontal-alignment: Look.rtl ? right : left;
        }
        if !Look.rtl : FileFacts { pick: root.pick; }
        if Look.rtl : VerticalLayout { alignment: center; FileBox { on: root.pick.on; locked: root.pick.locked; } }
    }
    ta := TouchArea { mouse-cursor: root.pick.locked ? default : pointer; clicked => { root.toggled(); } }
}

// The download sheet of a Ready download: its files with a checkbox each (the game itself
// always on), what the checked ones come to, the free space where it downloads and where it
// installs, and the game folder. Download and install, the first button, installs the game
// by itself once the download finishes; Download only downloads. It rises in over a dark wash,
// as the install sheet, and closes once the download starts.
component FilesSheet inherits Rectangle {
    in property <Torrent> torrent;
    // It rises in after its first frame.
    reveal := Reveal { }
    property <TextHorizontalAlignment> align: Look.rtl ? right : left;
    property <int> f: root.torrent.picks.length;
    property <length> row-h: 46 * Look.px;
    // Keeps the focused file in view: five show; the rest scroll.
    property <int> at: Dl.start-focus;
    changed at => {
        if (root.at >= 0 && root.at < root.f) {
            file-list.viewport-y = -Math.max(0, root.at - 4) * root.row-h;
        }
    }
    background: reveal.in-view ? Tokens.color-shade.with-alpha(0.69) : transparent;
    animate background { duration: Tokens.motion-normal; }
    TouchArea { }
    Rectangle {
        width: Math.min(940 * Look.px, root.width - 120 * Look.px);
        height: Math.min(col.preferred-height, root.height - 40 * Look.px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + (1 - reveal.move) * 30 * Look.px;
        opacity: reveal.fade;
        border-radius: 28 * Look.px;
        background: Tokens.color-surface;
        border-width: 1px;
        border-color: Look.line;
        drop-shadow-blur: 60 * Look.px;
        drop-shadow-color: Tokens.color-shade.with-alpha(0.8);
        clip: true;
        col := VerticalLayout {
            padding: 32 * Look.px;
            spacing: 10 * Look.px;
            Text {
                text: "Choose what to download";
                font-size: 30 * Look.px;
                font-weight: 700;
                color: Tokens.color-text;
                horizontal-alignment: root.align;
                accessible-role: text;
                accessible-label: "start-title";
                accessible-value: self.text;
            }
            Text {
                text: root.torrent.title + (root.torrent.version != "" ? " · " + root.torrent.version : "") + (root.torrent.region != "" ? " · " + root.torrent.region : "");
                font-size: 20 * Look.px;
                color: Tokens.color-text-muted;
                overflow: elide;
                horizontal-alignment: root.align;
            }
            HorizontalLayout {
                spacing: 12 * Look.px;
                alignment: stretch;
                // Select all on the start side, then Select none; the line before them.
                for n in (Look.rtl ? [-1, -2] : []) : Pill {
                    text: n == -2 ? "Select all" : "Select none";
                    h: 44 * Look.px;
                    focused: Dl.start-focus == n;
                    accessible-role: button;
                    accessible-label: n == -2 ? "start-all" : "start-none";
                    accessible-item-selected: self.focused;
                    accessible-action-default => { Dl.pick-all(n == -2); }
                    clicked => { Dl.start-focus = n; Dl.pick-all(n == -2); }
                }
                Text {
                    text: root.torrent.picked + (root.torrent.picks.length < root.torrent.file-count ? " · the files past the first " + root.torrent.picks.length + " always download" : "");
                    font-size: 18 * Look.px;
                    color: Tokens.color-text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: root.align;
                    accessible-role: text;
                    accessible-label: "start-picked";
                    accessible-value: self.text;
                }
                for n in (Look.rtl ? [] : [-2, -1]) : Pill {
                    text: n == -2 ? "Select all" : "Select none";
                    h: 44 * Look.px;
                    focused: Dl.start-focus == n;
                    accessible-role: button;
                    accessible-label: n == -2 ? "start-all" : "start-none";
                    accessible-item-selected: self.focused;
                    accessible-action-default => { Dl.pick-all(n == -2); }
                    clicked => { Dl.start-focus = n; Dl.pick-all(n == -2); }
                }
            }
            Rectangle {
                height: Math.min(5, root.f) * root.row-h;
                clip: true;
                file-list := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.width;
                    viewport-height: root.f * root.row-h;
                    animate viewport-y { duration: Tokens.motion-fast; }
                    accessible-role: list;
                    accessible-label: "download-files";
                    accessible-value: root.f;
                    for p[i] in root.torrent.picks : FileRow {
                        x: 0;
                        y: i * root.row-h;
                        width: parent.width;
                        pick: p;
                        focused: Dl.start-focus == i;
                        toggled => { Dl.start-focus = i; Dl.toggle-file(i); }
                    }
                }
            }
            // The two drives: where the files go, and where the game goes. A typed game folder's
            // drive is the core's to check.
            Text {
                text: "Download folder: " + (root.torrent.download-free != "" ? root.torrent.download-free : "free space unknown")
                    + (root.torrent.install-folder != "" && Dl.start-folder == "" ? "   ·   Game folder: " + (root.torrent.install-free != "" ? root.torrent.install-free : "free space unknown") : "");
                font-size: 17 * Look.px;
                color: Tokens.color-text-muted;
                wrap: word-wrap;
                horizontal-alignment: root.align;
                accessible-role: text;
                accessible-label: "start-space";
                accessible-value: self.text;
            }
            if root.torrent.download-room != "" || (root.torrent.install-room != "" && Dl.start-folder == "") : Text {
                text: root.torrent.download-room != "" ? root.torrent.download-room + ": uncheck files or free some space."
                    : root.torrent.install-room + ": uncheck files, pick another game folder, or press Download.";
                font-size: 17 * Look.px;
                color: Tokens.color-warning;
                wrap: word-wrap;
                horizontal-alignment: root.align;
                accessible-role: text;
                accessible-label: "start-room";
                accessible-value: self.text;
            }
            // Where the game goes: Enter opens it for typing, a folder inside a game folder.
            if root.torrent.install-folder != "" : folder-row := Row {
                property <bool> typing: Prefs.editing && self.focused;
                label: "Game folder";
                hint: "Inside a game folder (Settings) · Download and install puts the game here";
                first: true;
                last: true;
                focused: Dl.start-focus == root.f;
                accessible-role: button;
                accessible-label: "start-folder";
                accessible-value: Dl.shown-start-folder;
                accessible-action-default => { Dl.edit-start-folder(); }
                clicked => { Dl.edit-start-folder(); }
                if !folder-row.typing : Value { text: Dl.shown-start-folder; }
                if folder-row.typing : Editor { horizontal-stretch: 2; done(text) => { Dl.start-folder = text; Dl.start-focus = root.f + 1; } }
            }
            Text {
                text: (root.torrent.install-folder != ""
                        ? "Download and install installs the game by itself once the download finishes; if the install fails, the downloaded files stay. "
                        : "This emulator has no game folder: add one in Settings to install. ")
                    + "Files you leave out never download, and the download folder gets no file for them.";
                font-size: 16 * Look.px;
                color: Tokens.color-accent-soft;
                wrap: word-wrap;
                horizontal-alignment: root.align;
                accessible-role: text;
                accessible-label: "start-note";
                accessible-value: self.text;
            }
            if root.torrent.install-error != "" : Text {
                text: root.torrent.install-error;
                font-size: 17 * Look.px;
                color: Tokens.color-danger;
                wrap: word-wrap;
                horizontal-alignment: root.align;
                accessible-role: text;
                accessible-label: "start-error";
                accessible-value: self.text;
            }
            // Download and install first: on the left, or on the right from right to left.
            HorizontalLayout {
                spacing: 14 * Look.px;
                alignment: Look.rtl ? end : start;
                padding-top: 8 * Look.px;
                for b in (Look.rtl ? [3, 2, 1] : [1, 2, 3]) : Pill {
                    text: b == 1 ? "Download and install" : b == 2 ? "Download" : "Not now";
                    icon: b == 1 ? "download" : "";
                    primary: b == 1;
                    enabled: b == 1 ? Dl.can-install : b == 2 ? Dl.can-download : true;
                    focused: Dl.start-focus == root.f + b;
                    dim: Dl.start-focus != root.f + 1;
                    accessible-role: button;
                    accessible-label: b == 1 ? "start-install" : b == 2 ? "start-download" : "start-not-now";
                    accessible-value: self.text;
                    accessible-item-selected: self.focused;
                    accessible-enabled: self.enabled;
                    accessible-action-default => { self.clicked(); }
                    clicked => {
                        Dl.start-focus = root.f + b;
                        if (b == 3) { Dl.close-start(); } else { Dl.begin(b == 1); }
                    }
                }
            }
        }
    }
}

// One answer on the remove sheet: the whole width of the card, what it does under it. The
// focused one is white, or red when it deletes.
component RemoveChoice inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> danger;
    in property <bool> focused;
    in property <string> name;
    callback picked();
    property <color> ink: root.focused ? (root.danger ? Tokens.color-tint : Look.ink) : root.danger ? Tokens.color-danger : Tokens.color-text;
    height: col.preferred-height;
    border-radius: 16 * Look.px;
    background: root.focused ? (root.danger ? Tokens.color-danger : Tokens.color-tint) : ta.has-hover ? Tokens.color-tint.with-alpha(0.078) : Tokens.color-tint.with-alpha(0.039);
    border-width: 1px;
    border-color: root.focused ? transparent : root.danger ? Tokens.color-danger.with-alpha(0.251) : Look.line;
    animate background { duration: Tokens.motion-fast; }
    accessible-role: button;
    accessible-label: root.name;
    accessible-value: root.label;
    accessible-item-selected: root.focused;
    accessible-action-default => { root.picked(); }
    col := VerticalLayout {
        padding-left: 22 * Look.px;
        padding-right: 22 * Look.px;
        padding-top: 14 * Look.px;
        padding-bottom: 14 * Look.px;
        spacing: 4 * Look.px;
        Text {
            text: root.label;
            font-size: 22 * Look.px;
            font-weight: 600;
            color: root.ink;
            horizontal-alignment: Look.rtl ? right : left;
        }
        if root.hint != "" : Text {
            text: root.hint;
            font-size: 16 * Look.px;
            color: root.focused ? root.ink.with-alpha(0.75) : Tokens.color-text-muted;
            wrap: word-wrap;
            horizontal-alignment: Look.rtl ? right : left;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
}

// Remove asks first whether the downloaded files go too: a list of answers, each saying what
// it does. Remove from Downloads, the safe answer, comes first and has the keys; Delete files
// too is red.
component RemoveSheet inherits Rectangle {
    in property <Torrent> torrent;
    // It rises in after its first frame.
    reveal := Reveal { }
    property <TextHorizontalAlignment> align: Look.rtl ? right : left;
    background: reveal.in-view ? Tokens.color-shade.with-alpha(0.69) : transparent;
    animate background { duration: Tokens.motion-normal; }
    // A click beside the sheet is Not now.
    TouchArea { clicked => { Dl.answer-remove(2); } }
    Rectangle {
        width: Math.min(640 * Look.px, root.width - 80 * Look.px);
        height: col.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + (1 - reveal.move) * 30 * Look.px;
        opacity: reveal.fade;
        border-radius: 28 * Look.px;
        background: Tokens.color-surface;
        border-width: 1px;
        border-color: Look.line;
        drop-shadow-blur: 60 * Look.px;
        drop-shadow-color: Tokens.color-shade.with-alpha(0.8);
        TouchArea { }
        col := VerticalLayout {
            padding: 36 * Look.px;
            spacing: 10 * Look.px;
            Text {
                text: "Remove " + root.torrent.title + "?";
                font-size: 30 * Look.px;
                font-weight: 700;
                color: Tokens.color-text;
                wrap: word-wrap;
                horizontal-alignment: root.align;
                accessible-role: text;
                accessible-label: "remove-title";
                accessible-value: self.text;
            }
            if root.torrent.version != "" || root.torrent.region != "" : Text {
                text: root.torrent.version + (root.torrent.version != "" && root.torrent.region != "" ? " · " : "") + root.torrent.region;
                font-size: 18 * Look.px;
                color: Tokens.color-text-muted;
                overflow: elide;
                horizontal-alignment: root.align;
            }
            Rectangle { height: 10 * Look.px; }
            for choice in [0, 1, 2] : RemoveChoice {
                label: choice == 0 ? "Remove from Downloads" : choice == 1 ? "Delete files too" : "Not now";
                hint: choice == 0 ? "The downloaded files stay in their folder."
                    : choice == 1 ? "Deletes the folder and the copy " + Brand.name + " unpacked. A game you installed stays."
                    : "";
                danger: choice == 1;
                focused: Dl.remove-focus == choice;
                name: choice == 0 ? "remove-keep" : choice == 1 ? "remove-delete" : "remove-not-now";
                picked => { Dl.remove-focus = choice; Dl.answer-remove(choice); }
            }
            if root.torrent.folder != "" : Text {
                text: root.torrent.folder;
                font-size: 15 * Look.px;
                color: Look.text3;
                overflow: elide;
                horizontal-alignment: root.align;
            }
        }
    }
}

// Downloads, as a sheet: one card per transfer, with its bar and its buttons.
export component DownloadsPage inherits Rectangle {
    // False while it goes: Back, or another screen opened. It fades out as it came in.
    in property <bool> open: true;
    // Its column rises in after its first frame.
    reveal := Reveal { open: root.open; }
    background: Tokens.color-bg.with-alpha(0.851);
    property <TextHorizontalAlignment> align: Look.rtl ? right : left;

    // Keeps the focused card in view.
    function reveal(y: length, h: length) {
        let top = y - flick.absolute-position.y;
        let margin = 120 * Look.px;
        if (top + h > flick.height - margin) {
            flick.viewport-y = Math.max(flick.height - flick.viewport-height, flick.viewport-y - (top + h - flick.height + margin));
        } else if (top < margin) {
            flick.viewport-y = Math.min(0, flick.viewport-y + (margin - top));
        }
    }

    flick := Flickable {

        // Up and down only: nothing drags sideways.

        viewport-width: self.width;
        x: 120 * Look.px;
        y: 120 * Look.px;
        width: root.width - 240 * Look.px;
        height: root.height - self.y;
        viewport-height: col.preferred-height + 120 * Look.px;
        animate viewport-y { duration: Tokens.motion-normal; easing: ease-out-quad; }
        col := VerticalLayout {
            width: parent.width;
            // The cards keep their own height; the room left over stays below them.
            alignment: start;
            spacing: 14 * Look.px;
            y: (1 - reveal.move) * 20 * Look.px;
            opacity: reveal.fade;

            Text { text: "Downloads"; font-size: 44 * Look.px; font-weight: 600; color: Tokens.color-text; horizontal-alignment: root.align; }
            property <int> count: Vm.downloads.length + Vm.torrents.length;
            // The VPN's state, then what downloads and shares, of all the transfers.
            property <string> vpn: !Vm.vpn.only ? "" : Vm.vpn.route != "" ? "Protected by your VPN · " + Vm.vpn.route : "Waiting for your VPN";
            if self.count > 0 || self.vpn != "" : Text {
                text: parent.count == 0 ? parent.vpn
                    : (parent.vpn != "" ? parent.vpn + " · " : "") + Vm.torrents-downloading + " downloading · " + Vm.torrents-sharing + " sharing · " + parent.count + " in all";
                font-size: 19 * Look.px;
                color: Tokens.color-text-muted;
                wrap: word-wrap;
                horizontal-alignment: root.align;
                accessible-role: text;
                accessible-label: "downloads-summary";
                accessible-value: self.text;
            }
            // How transfers behave, as the core runs them.
            Text {
                text: "Downloads go on while " + Brand.name + " is open, also when it is minimized, and stop when you close it. At the next start, unfinished ones come back paused. "
                    + (Vm.seed-downloads
                        ? "Finished downloads go on sharing while " + Brand.name + " is open: Stop sharing stops one until the next start, and Keep sharing finished downloads, in Settings, stops them all."
                        : "Finished downloads don't share: Keep sharing finished downloads is off in Settings.");
                font-size: 17 * Look.px;
                color: Look.text3;
                wrap: word-wrap;
                horizontal-alignment: root.align;
                accessible-role: text;
                accessible-label: "downloads-note";
                accessible-value: self.text;
            }
            Rectangle { height: 8 * Look.px; }
            for t[n] in Vm.torrents : card := Rectangle {
                // An install that didn't start: "Download and install", or the install sheet.
                property <bool> not-started: t.state == "complete" && t.install == "" && t.install-error != "";
                property <bool> failed: t.state == "failed" || t.install == "failed" || t.unpack == "failed" || self.not-started;
                property <bool> done: t.state == "complete";
                property <bool> waiting: t.state == "resolving" || t.install == "installing";
                property <bool> focused: Dl.row == n;
                changed focused => { if (self.focused) { root.reveal(self.absolute-position.y, self.height); } }
                background: self.failed ? Tokens.color-danger.mix(Tokens.color-bg, 0.18) : Tokens.color-surface;
                border-radius: 18 * Look.px;
                border-width: self.focused ? 2 * Look.px : 1px;
                border-color: self.focused ? Look.ring : Look.line;
                accessible-role: text;
                accessible-label: "torrent";
                accessible-value: t.title + " " + t.state;
                VerticalLayout {
                    padding: 22 * Look.px;
                    spacing: 10 * Look.px;
                    HorizontalLayout {
                        spacing: 20 * Look.px;
                        Text {
                            text: t.title + (t.version != "" ? " · " + t.version : "") + (t.region != "" ? " · " + t.region : "");
                            font-size: 24 * Look.px;
                            font-weight: 600;
                            color: Tokens.color-text;
                            overflow: elide;
                            horizontal-stretch: 1;
                            horizontal-alignment: root.align;
                        }
                        Text {
                            // The core words it; a store's install says the store does it:
                            // "Downloading in Steam".
                            text: t.state-text;
                            font-size: 17 * Look.px;
                            color: card.failed ? Tokens.color-danger : card.done ? Tokens.color-success : Tokens.color-accent-soft;
                            accessible-role: text;
                            accessible-label: "torrent-state";
                            accessible-value: self.text;
                        }
                    }
                    ProgressBar {
                        progress: t.install == "installing" ? t.install-progress : t.unpack == "unpacking" ? t.unpack-progress : t.progress;
                        bar-color: card.done ? Tokens.color-success : card.failed ? Tokens.color-danger : Tokens.color-accent;
                    }
                    Text { text: t.detail; font-size: 18 * Look.px; color: Tokens.color-text-muted; overflow: elide; horizontal-alignment: root.align; }
                    // The files to look at before Download: up to 100, in a list that scrolls.
                    if t.state == "ready" : VerticalLayout {
                        spacing: 6 * Look.px;
                        Text {
                            text: t.file-summary;
                            font-size: 18 * Look.px;
                            color: Tokens.color-text;
                            horizontal-alignment: root.align;
                            accessible-role: text;
                            accessible-label: "torrent-file-summary";
                            accessible-value: self.text;
                        }
                        // Six rows show; the rest scroll.
                        Rectangle {
                            height: Math.min(6, t.files.length) * 24 * Look.px;
                            clip: true;
                            Flickable {
                                width: parent.width;
                                height: parent.height;
                                viewport-width: self.width;
                                viewport-height: t.files.length * 24 * Look.px;
                                accessible-role: list;
                                accessible-label: "torrent-files";
                                accessible-value: t.files.length;
                                VerticalLayout {
                                    width: parent.width;
                                    alignment: start;
                                    for f in t.files : Text {
                                        height: 24 * Look.px;
                                        vertical-alignment: center;
                                        text: f;
                                        font-size: 16 * Look.px;
                                        color: Look.text3;
                                        overflow: elide;
                                        horizontal-alignment: root.align;
                                        accessible-role: text;
                                        accessible-label: "torrent-file";
                                        accessible-value: f;
                                    }
                                }
                            }
                        }
                    }
                    Text { text: t.folder; font-size: 15 * Look.px; color: Look.text3; overflow: elide; horizontal-alignment: root.align; }
                    if t.error != "" : Text { text: t.error; font-size: 17 * Look.px; color: Tokens.color-danger; wrap: word-wrap; horizontal-alignment: root.align; }
                    HorizontalLayout {
                        spacing: 14 * Look.px;
                        alignment: Look.rtl ? end : start;
                        // While it looks up its files or installs, the first button says so
                        // and does nothing; the keys skip it.
                        if card.waiting : Button {
                            text: t.install == "installing" ? "Installing…" : "Resolving…";
                            primary: true;
                            enabled: false;
                            accessible-role: button;
                            accessible-label: "torrent-placeholder";
                            accessible-value: self.text;
                        }
                        for action[i] in t.actions : Button {
                            primary: i == 0 && !card.waiting;
                            focused: card.focused && Dl.at == i;
                            text: action == "start" ? (t.state == "ready" ? "Download" : t.state == "paused" ? "Resume" : "Retry")
                                : action == "pause" ? "Pause"
                                : action == "cancel" ? (t.unpack == "unpacking" ? "Stop unpacking" : "Cancel")
                                : action == "remove" ? "Remove"
                                : action == "stop-seeding" ? "Stop sharing"
                                : action == "install" ? (t.install == "failed" ? "Retry install" : t.unpack == "failed" || t.unpack == "cancelled" ? "Unpack and install" : "Install")
                                : action == "remove-unpacked" ? "Remove unpacked files"
                                : action == "cancel-install" ? "Cancel install"
                                : action == "open-store" ? "Open in " + t.store
                                : "Play";
                            accessible-role: button;
                            accessible-label: "torrent-action:" + action;
                            accessible-value: t.id;
                            accessible-action-default => { self.clicked(); }
                            clicked => { Dl.row = n; Dl.button = i; Dl.run(n, action); }
                        }
                        if Dl.has-folder(n) : Button {
                            text: "Open folder";
                            focused: card.focused && Dl.at == t.actions.length;
                            accessible-role: button;
                            accessible-label: "torrent-open-folder";
                            accessible-value: t.id;
                            accessible-action-default => { self.clicked(); }
                            clicked => { Dl.row = n; Dl.button = t.actions.length; Host.open-download-folder(t.id); }
                        }
                    }
                }
            }
            if Vm.downloads.length == 0 && Vm.torrents.length == 0 : Rectangle {
                background: Tokens.color-surface.mix(Tokens.color-accent, 0.94);
                border-radius: 20 * Look.px;
                VerticalLayout {
                    padding: 52 * Look.px;
                    spacing: 18 * Look.px;
                    alignment: center;
                    Text { text: "Nothing downloading yet"; font-size: 32 * Look.px; font-weight: 600; color: Tokens.color-text; horizontal-alignment: root.align; }
                    Text {
                        text: "Install an emulator in Emulators, or download a game from its Game Hub.";
                        font-size: 21 * Look.px;
                        color: Tokens.color-text-muted;
                        wrap: word-wrap;
                        horizontal-alignment: root.align;
                    }
                }
            }
            for job[i] in Vm.downloads : job-card := Rectangle {
                property <bool> failed: job.state == "failed";
                property <bool> done: job.state == "done";
                property <bool> focused: Dl.row == Vm.torrents.length + i;
                changed focused => { if (self.focused) { root.reveal(self.absolute-position.y, self.height); } }
                background: self.failed ? Tokens.color-danger.mix(Tokens.color-bg, 0.18) : Tokens.color-surface;
                border-radius: 18 * Look.px;
                border-width: self.focused ? 2 * Look.px : 1px;
                border-color: self.focused ? Look.ring : Look.line;
                VerticalLayout {
                    padding: 22 * Look.px;
                    spacing: 10 * Look.px;
                    HorizontalLayout {
                        spacing: 20 * Look.px;
                        Text { text: job.label; font-size: 24 * Look.px; font-weight: 600; color: Tokens.color-text; overflow: elide; horizontal-stretch: 1; horizontal-alignment: root.align; }
                        Text {
                            text: Look.job-state-label(job.state);
                            accessible-role: text;
                            accessible-label: "download-state";
                            accessible-value: self.text;
                            font-size: 17 * Look.px;
                            color: job.state == "failed" ? Tokens.color-danger : job.state == "done" ? Tokens.color-success : Tokens.color-accent-soft;
                        }
                    }
                    ProgressBar {
                        progress: job.progress;
                        bar-color: job.state == "done" ? Tokens.color-success : job.state == "failed" ? Tokens.color-danger : Tokens.color-accent;
                    }
                    Text { text: job.progress-text; font-size: 18 * Look.px; color: Tokens.color-text-muted; overflow: elide; horizontal-alignment: root.align; }
                    Text { text: job.plugin; font-size: 16 * Look.px; color: Look.text3; overflow: elide; horizontal-alignment: root.align; }
                    if job.error != "" : Text { text: job.error; font-size: 17 * Look.px; color: Tokens.color-danger; wrap: word-wrap; horizontal-alignment: root.align; }
                    HorizontalLayout {
                        spacing: 14 * Look.px;
                        alignment: Look.rtl ? end : start;
                        if job.can-resume : Button {
                            text: "Resume";
                            primary: true;
                            focused: job-card.focused && Dl.job-action(i, Dl.at) == "resume";
                            clicked => { Dl.row = Vm.torrents.length + i; Dl.button = 0; Commands.resume-download(job.id); }
                        }
                        if job.can-pause : Button {
                            text: "Pause";
                            focused: job-card.focused && Dl.job-action(i, Dl.at) == "pause";
                            clicked => {
                                Dl.row = Vm.torrents.length + i;
                                Dl.button = job.can-resume ? 1 : 0;
                                Commands.pause-download(job.id);
                            }
                        }
                        if job.can-cancel : Button {
                            text: "Cancel";
                            focused: job-card.focused && Dl.job-action(i, Dl.at) == "cancel";
                            clicked => {
                                Dl.row = Vm.torrents.length + i;
                                Dl.button = Dl.job-actions(i) - 1;
                                Commands.cancel-download(job.id);
                            }
                        }
                    }
                }
            }
            // What the card's buttons never do.
            if Vm.torrents.length > 0 : Text {
                text: "Cancel never deletes your downloaded files, and Remove asks first whether they go too. Remove unpacked files deletes only the copies " + Brand.name + " unpacked.";
                font-size: 17 * Look.px;
                color: Look.text3;
                wrap: word-wrap;
                horizontal-alignment: root.align;
                accessible-role: text;
                accessible-label: "downloads-footer";
                accessible-value: self.text;
            }
        }
    }

    if Dl.starting : FilesSheet {
        width: root.width;
        height: root.height;
        torrent: Vm.torrents[Dl.start];
    }
    if Dl.installing : InstallSheet {
        width: root.width;
        height: root.height;
        torrent: Vm.torrents[Dl.install];
    }
    if Dl.removing : RemoveSheet {
        width: root.width;
        height: root.height;
        torrent: Vm.torrents[Dl.remove];
    }
}
