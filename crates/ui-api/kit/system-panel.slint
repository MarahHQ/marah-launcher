import { Vm, Host, SystemJobItem, DriveItem } from "../types.slint";
import { Commands } from "commands.slint";
import { Tokens } from "../tokens.slint";
import { Look } from "look.slint";
import { Icon } from "icon.slint";
import { Switch } from "widgets.slint";
import { TextField } from "keyboard.slint";

// The machine's settings in the top bar (`Vm.system`): the network, sound and Bluetooth icons,
// and the drives' icon, open a panel under them. The network, sound and Bluetooth icons and
// panels show when Marah Launcher is the whole screen (the Marah Launcher session, Marah OS); a
// desktop has its own. The drives' icon and panel show wherever drives can be managed, on a
// desktop too. The battery shows wherever the PC has one.
//
// Each panel is a list of rows the keys move through:
//   0 Network     "Look for networks", then one row per Wi-Fi network
//   1 Sound       the volume (left and right change it), mute, then one row per output
//   2 Bluetooth   on or off, "Pair a device", then one row per device
//   3 Drives      one row per drive, with its actions as round buttons: Open, Use for games,
//                 then Eject (Unmount for a drive inside the PC) while it is mounted; Mount while
//                 it isn't. Left and right move between the buttons, then to the panel beside
// A secured network that isn't saved asks for its password first, with the on-screen keyboard.
export global Sys {
    // The open panel, or -1.
    in-out property <int> open: -1;
    in-out property <int> row;
    // In the Drives panel: the focused button of the focused drive, by its place in `actions`.
    in-out property <int> button;
    // The network whose password is being typed; "" for none.
    in-out property <string> asking;

    out property <bool> network-on: Vm.system.network-available;
    out property <bool> audio-on: Vm.system.audio-available;
    out property <bool> bluetooth-on: Vm.system.bluetooth-available;
    // The last panel the keys reach: the drives', while drives can be managed.
    out property <int> last: Vm.system.drives-available ? 3 : 2;

    public pure function rows(panel: int) -> int {
        panel == 0 ? (root.network-on ? 1 + Vm.system.wifi.length : 0)
            : panel == 1 ? (root.audio-on ? 2 + Vm.system.outputs.length : 0)
            : panel == 2 ? (root.bluetooth-on ? (Vm.system.bluetooth-on ? 2 + Vm.system.devices.length : 1) : 0)
            : panel == 3 ? Vm.system.drives.length
            : 0
    }
    public function show(panel: int) {
        root.open = panel;
        root.row = 0;
        root.button = 0;
        root.asking = "";
        Host.play-sound("select");
        Commands.refresh-system();
        if (panel == 3) { Commands.refresh-drives(); }
    }
    public function close() {
        root.open = -1;
        root.asking = "";
    }
    // The volume a step away, 0 to 100.
    function volume(delta: int) {
        Commands.set-volume(Math.clamp(Vm.system.volume + delta, 0, 100));
        Host.play-sound("move");
    }
    public function activate() {
        let r = root.row;
        if (root.open == 0) {
            if (r == 0) { Commands.scan-wifi(); return; }
            let net = Vm.system.wifi[r - 1];
            if (net.active) { return; }
            if (net.secured && !net.saved) { root.asking = net.ssid; return; }
            Commands.join-wifi(net.ssid, "");
        } else if (root.open == 1) {
            if (r == 0) { return; }
            if (r == 1) { Commands.set-muted(!Vm.system.muted); return; }
            Commands.set-audio-output(Vm.system.outputs[r - 2].name);
        } else if (root.open == 2) {
            if (r == 0) { Commands.set-bluetooth(!Vm.system.bluetooth-on); return; }
            if (r == 1) { Commands.scan-bluetooth(); return; }
            let device = Vm.system.devices[r - 2];
            if (!device.paired) { Commands.pair-device(device.address); }
            else if (device.connected) { Commands.disconnect-device(device.address); }
            else { Commands.connect-device(device.address); }
        } else if (root.open == 3) {
            if (r >= Vm.system.drives.length) { return; }
            let drive = Vm.system.drives[r];
            // While an action runs on the drive, its buttons wait.
            if (drive.busy != "" || root.button >= drive.actions.length) { Host.play-sound("error"); return; }
            let action = drive.actions[root.button];
            if (action == "mount") { Commands.mount-drive(drive.drive); }
            else if (action == "open") { root.close(); Commands.open-drive(drive.path); }
            else if (action == "use") { Commands.add-folder("games", drive.path); }
            else if (action == "eject") { Commands.eject-drive(drive.drive); }
            else if (action == "unmount") { Commands.unmount-drive(drive.drive); }
        }
        Host.play-sound("select");
    }
    // Handles a key while a panel is open. Returns whether it did anything.
    public function key(text: string) -> bool {
        if (text == Key.Escape || text == Key.Backspace) { root.close(); Host.play-sound("back"); return true; }
        if (text == Key.DownArrow) {
            if (root.row + 1 < root.rows(root.open)) { root.row += 1; root.button = 0; Host.play-sound("move"); }
            return true;
        }
        if (text == Key.UpArrow) {
            if (root.row > 0) { root.row -= 1; root.button = 0; Host.play-sound("move"); }
            return true;
        }
        // The Drives panel: left and right go between the focused drive's buttons first.
        if (root.open == 3 && root.row < Vm.system.drives.length && (text == Key.LeftArrow || text == Key.RightArrow)) {
            let next = root.button + ((text == Key.RightArrow) != Look.rtl ? 1 : -1);
            if (next >= 0 && next < Vm.system.drives[root.row].actions.length) {
                root.button = next;
                Host.play-sound("move");
                return true;
            }
        }
        if (root.open == 1 && root.row == 0 && (text == Key.LeftArrow || text == Key.RightArrow)) {
            root.volume((text == Key.RightArrow) != Look.rtl ? 10 : -10);
            return true;
        }
        // Left and right go to the panel beside, as on the top bar. On a desktop the drives'
        // panel is the only one.
        if (text == Key.LeftArrow || text == Key.RightArrow) {
            if (!Vm.system.whole-screen) { return true; }
            let next = root.open + ((text == Key.RightArrow) != Look.rtl ? 1 : -1);
            if (next >= 0 && next <= root.last) { root.show(next); }
            return true;
        }
        // Delete (the pad's Select) forgets a saved network or a paired device.
        if (text == Key.Delete) {
            if (root.open == 0 && root.row > 0 && Vm.system.wifi[root.row - 1].saved) {
                Commands.forget-wifi(Vm.system.wifi[root.row - 1].ssid);
            } else if (root.open == 2 && root.row > 1 && Vm.system.devices[root.row - 2].paired) {
                Commands.remove-device(Vm.system.devices[root.row - 2].address);
            }
            return true;
        }
        if (text == Key.Return || text == " ") { root.activate(); return true; }
        true
    }
}

// The network icon: Wi-Fi's strength over a dim full fan, a cable, or a slashed fan offline.
export component NetIcon inherits Rectangle {
    in property <color> tint: Tokens.color-text;
    width: 26 * Look.px;
    height: 26 * Look.px;
    if Vm.system.connection == "wired" : Icon { name: "wired"; color: root.tint; width: parent.width; height: parent.height; }
    if Vm.system.connection != "wired" : Icon { name: "wifi-4"; color: root.tint.with-alpha(0.3); width: parent.width; height: parent.height; }
    if Vm.system.connection == "wifi" && Vm.system.signal-bars > 0 : Icon {
        name: "wifi-" + Vm.system.signal-bars;
        color: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if Vm.system.connection == "none" : Icon { name: "slash"; color: root.tint; width: parent.width; height: parent.height; }
}

// The sound icon: the speaker with as many waves as the volume, or crossed out when muted.
export component SoundIcon inherits Icon {
    name: Vm.system.muted ? "volume-mute" : Vm.system.volume == 0 ? "volume-0" : Vm.system.volume < 50 ? "volume-1" : "volume-2";
    width: 26 * Look.px;
    height: 26 * Look.px;
}

// The Bluetooth icon: off, on, or with a device connected.
export component BluetoothIcon inherits Icon {
    name: !Vm.system.bluetooth-on ? "bluetooth-off" : Vm.system.connected-devices > 0 ? "bluetooth-on" : "bluetooth";
    width: 26 * Look.px;
    height: 26 * Look.px;
}

// The drives' icon: a USB drive is plugged in.
export component StorageIcon inherits Icon {
    name: "usb";
    width: 26 * Look.px;
    height: 26 * Look.px;
}

// A laptop's battery beside the clock: green while charging, amber at 20% or less, red at 10%
// or less. Sizes are whole pixels, so its edges stay sharp at every scale.
export component BatteryIcon inherits Rectangle {
    property <length> unit: Math.max(1px, Math.round(Look.px / 1px) * 1px);
    property <color> level: Vm.system.battery-charging ? Tokens.color-success
        : Vm.system.battery-percent <= 10 ? Tokens.color-danger
        : Vm.system.battery-percent <= 20 ? Tokens.color-warning : Tokens.color-text;
    width: row.preferred-width;
    accessible-role: text;
    accessible-label: "battery";
    accessible-value: Vm.system.battery-percent + (Vm.system.battery-charging ? " charging" : "");
    row := HorizontalLayout {
        height: parent.height;
        spacing: 6 * Look.px;
        alignment: center;
        Text { text: Vm.system.battery-percent + "%"; font-size: 18 * Look.px; color: Tokens.color-text-muted; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 0;
                body := Rectangle {
                    width: 18 * root.unit * 2;
                    height: 10 * root.unit * 2;
                    border-width: 2 * root.unit;
                    border-radius: 3 * root.unit;
                    border-color: root.level;
                    Rectangle {
                        x: 4 * root.unit;
                        y: 4 * root.unit;
                        width: Math.max(root.unit, Math.round((parent.width - 8 * root.unit) * Vm.system.battery-percent / 100 / 1px) * 1px);
                        height: parent.height - 8 * root.unit;
                        border-radius: root.unit;
                        background: root.level;
                    }
                    if Vm.system.battery-charging : Icon { name: "bolt"; color: Look.ink; width: parent.height; height: parent.height; }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle { width: 2 * root.unit; height: 8 * root.unit; border-radius: root.unit; background: root.level; }
                }
            }
        }
    }
}

// One row of a panel.
component PanelRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;
    in property <bool> current;
    in property <string> name;
    in property <string> value;
    callback clicked();
    height: 56 * Look.px;
    border-radius: 12 * Look.px;
    background: root.focused ? Tokens.color-tint.with-alpha(0.149) : ta.has-hover ? Tokens.color-tint.with-alpha(0.071) : transparent;
    border-width: root.focused ? 2 * Look.px : 0;
    border-color: Tokens.color-tint;
    accessible-role: button;
    accessible-label: root.name;
    accessible-value: root.value;
    accessible-item-selected: root.focused;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 18 * Look.px;
        padding-right: 18 * Look.px;
        spacing: 12 * Look.px;
        @children
        Text {
            text: root.label;
            font-size: 19 * Look.tpx;
            font-weight: root.current ? 600 : 400;
            color: Tokens.color-text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text { text: root.detail; font-size: 16 * Look.tpx; color: Look.text3; vertical-alignment: center; }
        if root.current : Icon { name: "check"; color: Tokens.color-success; width: 22 * Look.px; height: 22 * Look.px; y: (parent.height - self.height) / 2; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// What a Drives panel button does: its name for the player, and its icon.
global DriveActions {
    public pure function label(action: string) -> string {
        action == "open" ? "Open" : action == "use" ? "Use for games" : action == "mount" ? "Mount"
            : action == "unmount" ? "Unmount" : action == "eject" ? "Eject" : action
    }
    public pure function icon(action: string) -> string {
        action == "open" ? "folder" : action == "use" ? "gamepad" : action == "mount" ? "mount"
            : action == "unmount" ? "unmount" : "eject"
    }
}

// One round button of a drive's row: its icon, or a turning ring while its action runs. The
// focused or hovered one says its name under it.
component DriveButton inherits Rectangle {
    in property <string> action;
    in property <string> drive;
    in property <bool> focused;
    in property <bool> running;
    // Another action runs on the drive: this one waits.
    in property <bool> waiting;
    callback clicked();
    width: 44 * Look.px;
    height: 66 * Look.px;
    property <bool> named: root.focused || ta.has-hover;
    circle := Rectangle {
        y: 4 * Look.px;
        width: 44 * Look.px;
        height: 44 * Look.px;
        border-radius: self.height / 2;
        background: root.focused ? Tokens.color-focus : ta.has-hover && !root.waiting ? Tokens.color-tint.with-alpha(0.149) : Tokens.color-tint.with-alpha(0.071);
        opacity: root.waiting && !root.running ? 0.4 : 1;
        animate background { duration: Tokens.motion-fast; }
        accessible-role: button;
        accessible-label: root.action == "use" ? "use-for-games" : root.action;
        accessible-value: root.drive;
        accessible-description: DriveActions.label(root.action);
        accessible-item-selected: root.focused;
        accessible-action-default => { root.clicked(); }
        if !root.running : Icon {
            name: DriveActions.icon(root.action);
            color: root.focused ? Look.ink : Tokens.color-text;
            width: 24 * Look.px;
            height: 24 * Look.px;
        }
        if !root.running && root.action == "use" : Icon {
            name: "plus";
            color: root.focused ? Look.ink : Tokens.color-text;
            x: parent.width - 18 * Look.px;
            y: 4 * Look.px;
            width: 13 * Look.px;
            height: 13 * Look.px;
        }
        if root.running : Path {
            width: 26 * Look.px;
            height: 26 * Look.px;
            viewbox-width: 24;
            viewbox-height: 24;
            stroke: root.focused ? Look.ink : Tokens.color-text;
            stroke-width: 2.5 * Look.px;
            commands: "M 12 3 A 9 9 0 1 1 3 12";
            transform-rotation: Look.clock * 400deg;
        }
        ta := TouchArea { mouse-cursor: root.waiting ? default : pointer; clicked => { if (!root.waiting) { root.clicked(); } } }
    }
    // Wider than the button: "Use for games" is one line under it.
    Text {
        y: circle.y + circle.height + 3 * Look.px;
        x: (parent.width - self.width) / 2;
        width: 120 * Look.px;
        text: DriveActions.label(root.action);
        font-size: 12 * Look.tpx;
        color: root.named ? Tokens.color-text : transparent;
        horizontal-alignment: center;
    }
}

// One drive in the Drives panel: its kind's icon, its name and what it is, a thin bar of how
// full it is, and its actions as round buttons on the far side, in reading order.
component DriveRow inherits Rectangle {
    in property <DriveItem> drive;
    in property <bool> focused;
    // The focused button, by its place in the drive's actions; -1 for none.
    in property <int> button;
    callback pressed(int);
    height: 76 * Look.px;
    border-radius: 12 * Look.px;
    background: root.focused ? Tokens.color-tint.with-alpha(0.149) : ta.has-hover ? Tokens.color-tint.with-alpha(0.071) : transparent;
    border-width: root.focused ? 2 * Look.px : 0;
    border-color: Tokens.color-tint;
    accessible-role: list-item;
    accessible-label: "drive";
    accessible-value: root.drive.name;
    accessible-description: root.drive.detail;
    accessible-item-selected: root.focused;
    ta := TouchArea {}
    property <int> count: root.drive.actions.length;
    HorizontalLayout {
        padding-left: 16 * Look.px;
        padding-right: 12 * Look.px;
        spacing: 12 * Look.px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.drive.kind == "usb" ? "usb" : root.drive.kind == "card" ? "card" : "disk";
                color: Tokens.color-text-muted;
                width: 26 * Look.px;
                height: 26 * Look.px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3 * Look.px;
            Text { text: root.drive.name; font-size: 19 * Look.tpx; font-weight: 600; color: Tokens.color-text; overflow: elide; horizontal-alignment: Look.rtl ? right : left; }
            Text { text: root.drive.detail; font-size: 14 * Look.tpx; color: Look.text3; overflow: elide; horizontal-alignment: Look.rtl ? right : left; }
            if root.drive.used >= 0 : Rectangle {
                height: 4 * Look.px;
                border-radius: 2 * Look.px;
                background: Tokens.color-tint.with-alpha(0.122);
                Rectangle {
                    x: Look.rtl ? parent.width - self.width : 0;
                    width: parent.width * root.drive.used;
                    border-radius: 2 * Look.px;
                    background: root.drive.used > 0.9 ? Tokens.color-warning : Tokens.color-accent;
                }
            }
        }
        // Mirrored right to left: the first action stays nearest the text.
        HorizontalLayout {
            spacing: 6 * Look.px;
            alignment: end;
            for n[k] in root.count : DriveButton {
                property <int> at: Look.rtl ? root.count - 1 - k : k;
                action: root.drive.actions[self.at];
                drive: root.drive.name;
                focused: root.button == self.at;
                running: root.drive.busy == self.action;
                waiting: root.drive.busy != "";
                clicked => { root.pressed(self.at); }
            }
        }
    }
}

// The open panel, under the top bar on the side of its icons.
export component SystemSheet inherits Rectangle {
    // Closed by a click outside it.
    TouchArea { clicked => { Sys.close(); } }
    property <[SystemJobItem]> jobs: Vm.system.jobs;
    // The newest job of a kind for this panel, as a line of text.
    property <string> job-text: Sys.open == 0 ? root.job-of("join")
        : Sys.open == 2 ? (root.job-of("pair") != "" ? root.job-of("pair") : root.job-of("scan"))
        : Sys.open == 3 ? (root.job-of("eject") != "" ? root.job-of("eject")
            : root.job-of("unmount") != "" ? root.job-of("unmount") : root.job-of("mount"))
        : "";
    // Drives can't be managed any more: their panel closes, as their icon goes.
    property <bool> drives: Vm.system.drives-available;
    changed drives => { if (!root.drives && Sys.open == 3) { Sys.close(); } }
    // The newest of the last two jobs that is of `kind`: the panel's own work.
    pure function job-of(kind: string) -> string {
        root.jobs.length > 0 && root.jobs[root.jobs.length - 1].kind == kind ? root.jobs[root.jobs.length - 1].text
            : root.jobs.length > 1 && root.jobs[root.jobs.length - 2].kind == kind ? root.jobs[root.jobs.length - 2].text : ""
    }

    panel := Rectangle {
        width: Math.min(root.width - 32 * Look.px, 520 * Look.tpx);
        x: Look.rtl ? 96 * Look.px : root.width - self.width - 96 * Look.px;
        y: 96 * Look.px;
        height: Math.min(root.height - self.y - 40 * Look.px, body.preferred-height);
        border-radius: 22 * Look.px;
        background: Tokens.color-surface.with-alpha(0.949);
        border-width: 1px;
        border-color: Look.line;
        drop-shadow-blur: 24 * Look.px;
        drop-shadow-color: Tokens.color-shade.with-alpha(0.502);
        accessible-role: list;
        accessible-label: "system-panel";
        accessible-value: Sys.open == 0 ? "network" : Sys.open == 1 ? "sound" : Sys.open == 2 ? "bluetooth" : "drives";
        TouchArea {}
        clip: true;
        body := VerticalLayout {
            padding: 18 * Look.px;
            spacing: 6 * Look.px;
            Text {
                text: Sys.open == 0 ? (Vm.system.connection == "wifi" ? "Wi-Fi · " + Vm.system.network-name
                        : Vm.system.connection == "wired" ? "Cable · " + Vm.system.network-name : "Not connected")
                    : Sys.open == 1 ? (Vm.system.muted ? "Sound · Muted" : "Sound · " + Vm.system.volume + "%")
                    : Sys.open == 2 ? (Vm.system.bluetooth-on ? "Bluetooth · " + Vm.system.connected-devices + " connected" : "Bluetooth · Off")
                    : "Drives";
                font-size: 22 * Look.tpx;
                font-weight: 600;
                color: Tokens.color-text;
                width: parent.width;
                wrap: word-wrap;
            }
            if root.job-text != "" : Text {
                text: root.job-text;
                font-size: 16 * Look.tpx;
                color: Tokens.color-info;
                width: parent.width;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: "system-job";
                accessible-value: self.text;
            }
            // Why this part can't be used here.
            property <string> reason: Sys.open == 0 ? Vm.system.network-reason : Sys.open == 1 ? Vm.system.audio-reason
                : Sys.open == 2 ? Vm.system.bluetooth-reason : Vm.system.drives-reason;
            // The drives list what is there even where they can't be mounted: the reason shows
            // over them.
            if (Sys.rows(Sys.open) == 0 || (Sys.open == 3 && !Vm.system.drives-available)) && self.reason != "" : Text {
                text: parent.reason;
                font-size: 17 * Look.tpx;
                color: Look.text3;
                width: parent.width;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: "system-reason";
                accessible-value: self.text;
            }

            // The password of the network being joined.
            if Sys.asking != "" : Rectangle {
                height: 56 * Look.px;
                border-radius: 12 * Look.px;
                background: Tokens.color-tint.with-alpha(0.078);
                border-width: 2 * Look.px;
                border-color: Tokens.color-accent;
                field := TextField {
                    x: 16 * Look.px;
                    width: parent.width - 32 * Look.px;
                    height: parent.height;
                    name: "wifi-password";
                    title: "Password for " + Sys.asking;
                    password: true;
                    font-size: 19 * Look.tpx;
                    font-family: Tokens.font-family;
                    text-color: Tokens.color-text;
                    init => { self.focus(); }
                    accepted => {
                        Commands.join-wifi(Sys.asking, self.text);
                        Sys.asking = "";
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) { Sys.asking = ""; return accept; }
                        reject
                    }
                }
            }

            // Network.
            if Sys.open == 0 && Sys.network-on : PanelRow {
                label: "Look for networks";
                name: "wifi-scan";
                focused: Sys.row == 0 && Sys.asking == "";
                clicked => { Sys.row = 0; Sys.activate(); }
                Icon { name: "search"; color: Tokens.color-text-muted; width: 22 * Look.px; height: 22 * Look.px; y: (parent.height - self.height) / 2; }
            }
            if Sys.open == 0 && Sys.network-on : VerticalLayout {
                spacing: 6 * Look.px;
                for net[i] in Vm.system.wifi : PanelRow {
                    label: net.ssid;
                    detail: net.active ? "Connected" : net.saved ? "Saved" : net.secured ? "Secured" : "Open";
                    current: net.active;
                    name: "wifi";
                    value: net.ssid;
                    focused: Sys.row == 1 + i && Sys.asking == "";
                    clicked => { Sys.row = 1 + i; Sys.activate(); }
                    Rectangle {
                        width: 22 * Look.px;
                        Icon { name: "wifi-4"; color: Tokens.color-text.with-alpha(0.3); width: parent.width; height: parent.width; }
                        if net.bars > 0 : Icon { name: "wifi-" + net.bars; color: Tokens.color-text; width: parent.width; height: parent.width; }
                    }
                }
            }

            // Sound.
            if Sys.open == 1 && Sys.audio-on : PanelRow {
                label: "Volume";
                detail: Vm.system.volume + "%";
                name: "volume";
                value: Vm.system.volume;
                focused: Sys.row == 0;
                clicked => { Sys.row = 0; }
                SoundIcon { color: Tokens.color-text-muted; width: 22 * Look.px; height: 22 * Look.px; y: (parent.height - self.height) / 2; }
            }
            if Sys.open == 1 && Sys.audio-on : Rectangle {
                height: 8 * Look.px;
                Rectangle {
                    x: 18 * Look.px;
                    width: parent.width - 36 * Look.px;
                    height: 6 * Look.px;
                    border-radius: 3 * Look.px;
                    background: Tokens.color-tint.with-alpha(0.122);
                    Rectangle {
                        x: 0;
                        width: parent.width * Vm.system.volume / 100;
                        border-radius: 3 * Look.px;
                        background: Vm.system.muted ? Look.text3 : Tokens.color-accent;
                        animate width { duration: Tokens.motion-fast; }
                    }
                }
            }
            if Sys.open == 1 && Sys.audio-on : PanelRow {
                label: "Mute";
                name: "mute";
                value: Vm.system.muted ? "on" : "off";
                focused: Sys.row == 1;
                clicked => { Sys.row = 1; Sys.activate(); }
                VerticalLayout { alignment: center; Switch { on: Vm.system.muted; } }
            }
            if Sys.open == 1 && Sys.audio-on : VerticalLayout {
                spacing: 6 * Look.px;
                for out[i] in Vm.system.outputs : PanelRow {
                    label: out.description;
                    current: out.current;
                    name: "audio-output";
                    value: out.description;
                    focused: Sys.row == 2 + i;
                    clicked => { Sys.row = 2 + i; Sys.activate(); }
                }
            }

            // Drives: one row per drive, its actions as round buttons.
            if Sys.open == 3 && Vm.system.drives.length == 0 : Text {
                text: "No drives";
                font-size: 17 * Look.tpx;
                color: Look.text3;
                width: parent.width;
            }
            if Sys.open == 3 : VerticalLayout {
                spacing: 6 * Look.px;
                for drive[i] in Vm.system.drives : DriveRow {
                    drive: drive;
                    focused: Sys.row == i;
                    button: Sys.row == i ? Sys.button : -1;
                    pressed(k) => { Sys.row = i; Sys.button = k; Sys.activate(); }
                }
            }

            // Bluetooth.
            if Sys.open == 2 && Sys.bluetooth-on : PanelRow {
                label: "Bluetooth";
                name: "bluetooth-power";
                value: Vm.system.bluetooth-on ? "on" : "off";
                focused: Sys.row == 0;
                clicked => { Sys.row = 0; Sys.activate(); }
                VerticalLayout { alignment: center; Switch { on: Vm.system.bluetooth-on; } }
            }
            if Sys.open == 2 && Sys.bluetooth-on && Vm.system.bluetooth-on : PanelRow {
                label: "Pair a device";
                detail: "Put it in pairing mode first";
                name: "bluetooth-scan";
                focused: Sys.row == 1;
                clicked => { Sys.row = 1; Sys.activate(); }
            }
            if Sys.open == 2 && Sys.bluetooth-on && Vm.system.bluetooth-on : VerticalLayout {
                spacing: 6 * Look.px;
                for device[i] in Vm.system.devices : PanelRow {
                    label: device.name;
                    detail: device.connected ? "Connected" : device.paired ? "Paired" : "Pair";
                    current: device.connected;
                    name: "bluetooth-device";
                    value: device.name;
                    focused: Sys.row == 2 + i;
                    clicked => { Sys.row = 2 + i; Sys.activate(); }
                }
            }
        }
    }
}
