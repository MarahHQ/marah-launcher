import { Vm } from "../types.slint";
import { Tokens } from "../tokens.slint";
import { Look } from "look.slint";
import { StatusSlot, StatusState } from "loading.slint";
import { Motion } from "motion.slint";
import { Tray, TrayGlyph } from "tray.slint";

// The top bar's status icons, the same in every theme and wherever the launcher runs: the tray
// items in the bar now (`Vm.tray`, each item's `in-bar`), in the tray's order, then the ⌃ that
// opens the tray. The bar names no item: it draws whatever the core puts in it, and an item comes
// in and goes with the bar's motion (`StatusSlot`). Each icon opens its item (`Tray.open-item`):
// its panel, its screen, its Settings section or the power menu. A theme puts the bar in its top
// bar, before its Settings button, gives it the focused item, and puts the tray's ⌃
// (`TrayButton`) right after Settings, in the same group.

// A status icon, as a round button: what it opens shows under the bar. Its icon is its child.
// Its area's state shows over it (`StatusState`): loading, or disabled, which the bar never
// shows but a theme's own button may.
export component StatusButton inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> focused;
    in property <bool> current;
    // Its area's state and reason (`TrayItem`'s `state` and `reason`).
    in property <string> state: "ready";
    in property <string> reason;
    // The loading line under it. An icon that draws its own (the battery) turns it off.
    in property <bool> line: true;
    callback clicked();
    width: 52 * Look.px;
    height: 52 * Look.px;
    border-radius: self.height / 2;
    // A disabled icon's focus is the ring `StatusState` draws, not this fill.
    out property <bool> lit: status.lit;
    background: status.lit ? Tokens.color-tint
        : root.current ? Tokens.color-tint.with-alpha(0.141)
        : ta.has-hover && !status.disabled ? Tokens.color-tint.with-alpha(0.078) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-value: status.loading ? "loading" : status.disabled ? "disabled" : root.value;
    accessible-enabled: !status.disabled;
    accessible-description: status.disabled ? root.reason : "";
    accessible-action-default => { if (!status.disabled) { root.clicked(); } }
    animate background { duration: Motion.press; }
    Rectangle {
        opacity: status.dim;
        animate opacity { duration: Motion.focus; easing: Motion.enter; }
        @children
    }
    status := StatusState { state: root.state; reason: root.reason; line: root.line; focused: root.focused; hovered: ta.has-hover; }
    ta := TouchArea { mouse-cursor: status.cursor; clicked => { if (!status.disabled) { root.clicked(); } } }
}

// The items in the bar. Each item has a place, open while it is in the bar; the place
// holds the gap after it, so a place that closes closes its gap with it.
export component StatusBar inherits HorizontalLayout {
    // The item the keys or the pad are on, by its place in the bar (0 to `Tray.bar` - 1); -1 for
    // none.
    in property <int> focused: -1;
    // An icon's size, and the gap after each.
    in property <length> size: 52 * Look.px;
    in property <length> gap: 22 * Look.px;
    spacing: 0;
    // The focused item, by its place in `Vm.tray`.
    property <int> focused-item: root.focused >= 0 && root.focused < Tray.bar ? Vm.tray-bar[root.focused] : -1;
    // Each item is in place from the first frame, in its loading look until its area is read.
    for item[i] in Vm.tray : place := StatusSlot {
        open: item.in-bar;
        // The battery's level is wider than an icon.
        item-width: item.icon == "battery" ? 104 * Look.px : root.size;
        gap: root.gap;
        if place.shown : button := StatusButton {
            width: parent.width;
            height: root.size;
            label: "status:" + item.id;
            value: item.value;
            state: item.state;
            reason: item.reason;
            line: item.icon != "battery";
            current: Tray.current(item);
            focused: root.focused-item == i;
            clicked => { Tray.open-item(i); }
            TrayGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: item.icon;
                tint: button.lit ? Look.ink : Tokens.color-text;
            }
        }
    }
}
