import { Vm, Host } from "../types.slint";
import { Commands } from "../kit/commands.slint";
import { Games } from "../kit/games.slint";
import { Look } from "../kit/look.slint";
import { GameMenu } from "../kit/game-menu.slint";
import { Tray } from "../kit/tray.slint";
import { Origin } from "../kit/origin.slint";
// Origin is the kit's; the theme's files read it from here too.
export { Origin } from "../kit/origin.slint";

// Where the player is on the home screen, and what each key does there. The keys act on one
// zone at a time: the top bar (`tabs`), the tile row (`row`),
// the buttons under the game (`actions`), and in the Library its bar (`bar`: search, sort,
// Comfortable, Compact, and in the Catalog the catalog plugin's button), its systems
// (`filters`), its genres (`genres`) and its grid (`grid`).
//
// The top bar has two tabs, Home (0) and Library (1), then Search (2), then the kit's status
// bar (the tray items in the bar now), Settings, and the ⌃ that opens the tray last. The
// tabs open the Home screen and the Library screen. Home's row has every game; the Library's
// games are searched, filtered and sorted by the core (`Vm.home.library`). The Catalog screen
// is the same view on the catalogs' games (`Vm.catalog`), with the same zones but the top bar's.
export global Nav {
    in-out property <string> zone: "row";
    in-out property <int> tab;
    in-out property <int> action;
    // On Home, the focus is on the Library tile at the end of the row.
    in-out property <bool> extra;
    // The Library grid's columns, set by the grid.
    in-out property <int> columns: 1;
    // The focused item of the Library's bar, systems and genres.
    in-out property <int> bar;
    in-out property <int> filter;
    in-out property <int> genre;
    // The Library's smaller cards.
    in-out property <bool> compact;
    // The search box has the keys, for typing; the shell takes them back when it's false.
    in-out property <bool> typing;
    // A letter typed in the Library grid, for the search box to start with.
    in-out property <string> first-letter;
    // The list of sorts is open, with the keys on `sort-focus`.
    in-out property <bool> sort-open;
    in-out property <int> sort-focus;
    // How far each grid is scrolled. A screen's grid goes when a game's details open; the next
    // one starts where it was.
    in-out property <length> catalog-scroll;
    in-out property <length> library-scroll;
    // The shell's search opened the Library: the keys go to its search box there.
    in-out property <bool> to-search;

    out property <int> tabs: 2;
    // Search, the tray items in the bar now (`Tray.bar`), Settings, and the tray's ⌃ last.
    out property <int> buttons: 3 + root.statuses;
    out property <int> statuses: Tray.bar;
    // The shown game is the one running.
    out property <bool> playing: Games.has-game && Vm.has-running && Vm.running.key == Games.games[Games.shown].key;
    // The buttons under the game: Resume, Stop and Game Hub while it runs; Play (when it can
    // start) and Game Hub otherwise; then the store page when there is one, and the game's
    // menu ("⋯") once its details are in.
    out property <bool> store: Games.has-detail && Vm.detail.store-url != "";
    out property <int> hub-action: root.playing ? 2 : Games.has-detail && Vm.detail.can.play ? 1 : 0;
    out property <int> store-action: root.hub-action + 1;
    out property <int> actions: root.hub-action + 1 + (root.store ? 1 : 0) + (Games.has-detail ? 1 : 0);

    public pure function platform(entry: int) -> string {
        entry < 0 || entry >= Vm.home.groups.length ? "" : Vm.home.groups[entry].platform
    }
    public pure function count(entry: int) -> int {
        entry < 0 || entry >= Vm.home.groups.length ? Vm.home.games.length : Vm.home.groups[entry].games.length
    }

    // Opens the Library screen, as it was left: its filters stay in the core.
    public function open-library() {
        Host.play-sound("select");
        Commands.navigate("library");
    }
    // The shell's search: the Library, with the keys in its search box. From another screen,
    // the box takes them once the Library shows (`to-search`).
    public function search-library() {
        if (Games.library) {
            root.zone = "bar";
            root.bar = 0;
            root.typing = true;
        } else {
            root.to-search = true;
            Commands.navigate("library");
        }
    }
    // The tabs, then Search, the tray items in the bar, Settings, and the tray's ⌃ last. Home goes back to
    // the bottom of the stack: nothing is left to go back to.
    public function activate-tab(index: int) {
        let button = index - root.tabs;
        if (index == 0) {
            Commands.navigate("home");
        } else if (index == 1) {
            root.open-library();
        } else if (button >= 1 && button < 1 + root.statuses) {
            Tray.open-item(Vm.tray-bar[button - 1]);
        } else if (button == 2 + root.statuses) {
            Tray.toggle();
        } else {
            Host.play-sound("select");
            Commands.navigate(button == 0 ? "catalog" : "settings");
        }
    }
    // The Catalog's bar has the catalog plugin's first button (`Vm.catalog-actions`), such as
    // Refresh, after the card sizes.
    out property <bool> bar-button: Games.catalog && Vm.catalog-actions.length > 0;
    // The Library's bar: search, sort, Comfortable, Compact, then the Catalog's button.
    public function activate-bar(index: int) {
        if (index == 0) {
            root.typing = true;
        } else if (index == 1) {
            // The list of sorts, with the keys on the one in use.
            root.sort-open = true;
            root.sort-focus = Games.sort-index(Games.lib.sort);
        } else if (index == 4) {
            if (root.bar-button) {
                let button = Vm.catalog-actions[0];
                Commands.run-action(button.plugin, button.action, "", button.args);
            }
        } else {
            root.compact = index == 3;
        }
        Host.play-sound("select");
    }
    // The sort at `index` of `sorts`: the core sorts by it, and the list closes.
    public function pick-sort(index: int) {
        root.sort-open = false;
        Games.sort(index);
        Host.play-sound("select");
    }
    // The keys while the list of sorts is open: Up and Down move round it, Enter picks, Back
    // closes it. It takes every key.
    public function sort-key(text: string) {
        if (text == Key.UpArrow || text == Key.DownArrow) {
            let count = Games.sorts.length;
            root.sort-focus = Math.mod(root.sort-focus + (text == Key.DownArrow ? 1 : -1) + count, count);
            Host.play-sound("move");
        } else if (text == Key.Return) {
            root.pick-sort(root.sort-focus);
        } else if (text == Key.Escape || text == Key.Backspace) {
            root.sort-open = false;
            Host.play-sound("back");
        }
    }
    // Along the row: past the last game is the Library tile.
    public function step-row(delta: int) {
        if (root.extra) {
            if (delta < 0) { root.extra = false; Host.play-sound("move"); }
        } else if (Games.selected + delta >= Games.games.length && Games.games.length > 0) {
            root.extra = true;
            Host.play-sound("move");
        } else {
            Games.select(Games.selected < 0 ? 0 : Games.selected + delta);
        }
    }
    // L1 and R1 on Home: the keys go to the top bar, and on to the item before or after the one
    // they were on, round the ends. The first press starts from the screen shown.
    public function bar-step(delta: int) {
        Games.send();
        if (root.zone != "tabs") {
            root.zone = "tabs";
            root.tab = Games.library ? 1 : 0;
        }
        root.step-tab(delta);
    }
    public function step-tab(delta: int) {
        let next = root.tab + delta;
        // Search's place, with no Catalog: the next one on.
        let skipped = next == root.tabs && !Vm.catalog-available ? next + delta : next;
        // Round the ends: past the last item is the first.
        let count = root.tabs + root.buttons;
        root.tab = Math.mod(skipped + count, count);
        Host.play-sound("move");
    }
    // The button under the game at `action`.
    public function activate() {
        if (!Games.has-game) { return; }
        let key = Games.games[Games.shown].key;
        if (Games.has-detail && root.action == root.actions - 1) {
            GameMenu.show();
        } else if (root.store && root.action == root.store-action) {
            Host.open-url(Vm.detail.store-url);
        } else if (root.action == root.hub-action) {
            Host.play-sound("select");
            Origin.from = "row";
            Commands.open-game(key);
        } else if (root.playing) {
            if (root.action == 0) {
                Host.play-sound("select");
                Commands.show-game(Vm.running.session);
            } else {
                Host.play-sound("back");
                Commands.stop(Vm.running.session);
            }
        } else if (Games.has-detail && Vm.detail.can.play) {
            Commands.launch(Vm.detail.key);
        }
    }

    // Handles a key on the home screen. Returns whether it did anything.
    public function key(text: string) -> bool {
        // A key that isn't a move acts on the game on screen: the core hears of it first.
        if (!(text == Key.LeftArrow || text == Key.RightArrow || text == Key.UpArrow || text == Key.DownArrow
            || text == Key.PageUp || text == Key.PageDown)) {
            Games.send();
        }
        // Left and right follow the reading direction.
        if (text == Key.LeftArrow || text == Key.RightArrow) {
            if ((text == Key.RightArrow) == !Look.rtl) { return root.horizontal(1); }
            return root.horizontal(-1);
        }
        if (root.zone == "tabs") {
            if (text == Key.DownArrow) { root.go(Games.library ? "bar" : "row"); return true; }
            if (text == Key.Return) { root.activate-tab(root.tab); return true; }
            if (text == Key.Escape || text == Key.Backspace) { root.go(Games.library ? "grid" : "row"); return true; }
        } else if (root.zone == "row") {
            if (text == Key.UpArrow) { root.go("tabs"); root.tab = 0; return true; }
            if (text == Key.DownArrow && !root.extra && Games.has-game) { root.go("actions"); root.action = 0; return true; }
            if (text == Key.Return) {
                if (root.extra) {
                    root.open-library();
                } else if (Games.has-game) {
                    Host.play-sound("select");
                    Origin.from = "row";
                    Commands.open-game(Games.games[Games.shown].key);
                }
                return true;
            }
        } else if (root.zone == "actions") {
            if (text == Key.UpArrow || text == Key.Escape || text == Key.Backspace) { root.go("row"); return true; }
            if (text == Key.Return) { root.activate(); return true; }
        } else if (Games.catalog && (text == Key.Escape || text == Key.Backspace)) {
            // The Catalog is a screen of its own: back to where it opened from.
            Host.play-sound("back");
            Commands.back();
            return true;
        } else if (root.zone == "bar") {
            if (text == Key.UpArrow) { if (!Games.catalog) { root.go("tabs"); root.tab = 1; } return true; }
            if (text == Key.DownArrow) { root.go("filters"); return true; }
            if (text == Key.Return) { root.activate-bar(root.bar); return true; }
            if (text == Key.Escape || text == Key.Backspace) { root.leave(); return true; }
        } else if (root.zone == "filters") {
            if (text == Key.UpArrow) { root.go("bar"); return true; }
            if (text == Key.DownArrow) { root.go(Games.lib.genres.length > 1 ? "genres" : "grid"); return true; }
            if (text == Key.Return) { Games.system(Games.lib.systems[root.filter].id); Host.play-sound("select"); return true; }
            if (text == Key.Escape || text == Key.Backspace) { root.leave(); return true; }
        } else if (root.zone == "genres") {
            if (text == Key.UpArrow) { root.go("filters"); return true; }
            if (text == Key.DownArrow) { root.go("grid"); return true; }
            if (text == Key.Return) { Games.genre(Games.lib.genres[root.genre].id); Host.play-sound("select"); return true; }
            if (text == Key.Escape || text == Key.Backspace) { root.leave(); return true; }
        } else if (root.zone == "grid") {
            if (text == Key.UpArrow) {
                if (Games.selected < root.columns) { root.go(Games.lib.genres.length > 1 ? "genres" : "filters"); } else { Games.select(Games.selected - root.columns); }
                return true;
            }
            if (text == Key.DownArrow) {
                if (Games.selected + root.columns < Games.games.length) { Games.select(Games.selected < 0 ? 0 : Games.selected + root.columns); }
                return true;
            }
            if (text == Key.Return) {
                if (Games.has-game) {
                    Host.play-sound("select");
                    Origin.from-grid();
                    Commands.open-game(Games.games[Games.shown].key);
                }
                return true;
            }
            if (text == Key.Escape || text == Key.Backspace) { root.leave(); return true; }
            // L2 and R2, Page Up and Page Down: three lines at a time.
            if (text == Key.PageUp || text == Key.PageDown) {
                let step = root.columns * 3 * (text == Key.PageDown ? 1 : -1);
                Games.select(Math.clamp(Math.max(Games.selected, 0) + step, 0, Games.games.length - 1));
                return true;
            }
            // Typing a letter or a digit searches.
            if (text.character-count == 1 && ((text >= "a" && text <= "z") || (text >= "A" && text <= "Z") || (text >= "0" && text <= "9"))) {
                root.first-letter = text;
                root.zone = "bar";
                root.bar = 0;
                root.typing = true;
                return true;
            }
        }
        false
    }
    // Back from the Library to the screen under it, with the back sound.
    function leave() {
        Host.play-sound("back");
        Commands.back();
    }
    // Moves the keys to another zone, with the move sound.
    function go(zone: string) {
        Games.send();
        root.zone = zone;
        Host.play-sound("move");
    }
    function horizontal(delta: int) -> bool {
        if (root.zone == "tabs") { root.step-tab(delta); }
        if (root.zone == "row") { root.step-row(delta); }
        if (root.zone == "actions") { root.action = Math.clamp(root.action + delta, 0, root.actions - 1); Host.play-sound("move"); }
        if (root.zone == "bar") { root.bar = Math.clamp(root.bar + delta, 0, root.bar-button ? 4 : 3); Host.play-sound("move"); }
        if (root.zone == "filters") { root.filter = Math.clamp(root.filter + delta, 0, Games.lib.systems.length - 1); Host.play-sound("move"); }
        if (root.zone == "genres") { root.genre = Math.clamp(root.genre + delta, 0, Games.lib.genres.length - 1); Host.play-sound("move"); }
        if (root.zone == "grid") { Games.select(Games.selected < 0 ? 0 : Games.selected + delta); }
        true
    }
}
